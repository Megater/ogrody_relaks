---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Title from '../components/Main_page_parts/title.astro';
import Uslugi from '../components/Main_page_parts/uslugi.astro';
import Realizacje from '../components/Main_page_parts/realizacje.astro';
import Process from '../components/Main_page_parts/process.astro';
import Testimonials from '../components/Main_page_parts/Testimonials.astro';
import Booking from '../components/Main_page_parts/booking.astro';

import main_photo from '../assets/images/Kamil_title_photo.jpg';

// Preload mobilnego zdjęcia LCP w <head>
const preloadHero = await getImage({
  src: main_photo,
  width: 1200,
  format: 'webp',
  quality: 85
});
---

<Layout preloadImage={preloadHero.src}>
	<div id="page" class="page">
			<Title/>
			<Uslugi/>
			<Realizacje/>
			<Process/>
			<Testimonials/>
			<Booking/>
	</div>
</Layout>
