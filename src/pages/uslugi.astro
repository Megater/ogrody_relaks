---
// src/pages/uslugi.astro
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import imageUrlBuilder from '@sanity/image-url';

// Importy lokalnych zdjęć zapasowych (fallback)
import trawnikImg from '../assets/images/Realizacje/trawnik.jpg';
import porzadkowanieImg from '../assets/images/Realizacje/porzadkowanie_dzialki.jpg';
import dzialkaPrzedPoImg from '../assets/images/Realizacje/dzialka_przed_po.jpg';
import kosiaraImg from '../assets/images/kosiara.jpg';
import anthonyImg from '../assets/images/anthony-Apips1tJsXo-unsplash.jpg';
import claudeImg from '../assets/images/claude-laprise-lW2TOQZ_bys-unsplash.jpg';

interface ServiceItem {
  title: string;
  slug: string;
  badge: string;
  icon: string;
  shortDescription: string;
  description: string;
  features: string[];
  images: string[];
}

const builder = imageUrlBuilder(sanityClient);
function urlFor(source: any) {
  return builder.image(source);
}

// 1. Pobieranie z Sanity
let sanityUslugi: any[] = [];
try {
  sanityUslugi = await sanityClient.fetch(`
    *[_type == "usluga"] | order(order asc, _createdAt desc) {
      title,
      "slug": slug.current,
      badge,
      icon,
      shortDescription,
      description,
      features,
      image,
      gallery,
      order
    }
  `);
} catch (error) {
  console.warn("Błąd pobierania usług z Sanity – używam danych zastępczych.");
}

function getImgSrc(img: any): string {
  if (!img) return '';
  if (typeof img === 'string') return img;
  if (img.src) return img.src;
  if (img.asset) {
    try {
      return urlFor(img).width(1000).quality(85).auto('format').url();
    } catch {
      return '';
    }
  }
  return '';
}

// 2. Dane zapasowe (fallback)
const trawnikSrc = typeof trawnikImg === 'string' ? trawnikImg : trawnikImg.src;
const porzadkowanieSrc = typeof porzadkowanieImg === 'string' ? porzadkowanieImg : porzadkowanieImg.src;
const dzialkaPrzedPoSrc = typeof dzialkaPrzedPoImg === 'string' ? dzialkaPrzedPoImg : dzialkaPrzedPoImg.src;
const kosiaraSrc = typeof kosiaraImg === 'string' ? kosiaraImg : kosiaraImg.src;
const anthonySrc = typeof anthonyImg === 'string' ? anthonyImg : anthonyImg.src;
const claudeSrc = typeof claudeImg === 'string' ? claudeImg : claudeImg.src;

const fallbackUslugi: ServiceItem[] = [
  {
    title: "Pielęgnacja i regeneracja trawników",
    slug: "pielegnacja-trawnikow",
    badge: "Wiosna / Cały sezon",
    icon: "🌱",
    shortDescription: "Kompleksowa regeneracja darni: wertykulacja, aeracja, dosiewki oraz profesjonalne nawożenie mineralne.",
    description: "Soczysty, gęsty trawnik to wizytówka każdej posesji. Nasz program regeneracji przywraca darni siłę po zimie i zabezpiecza przed letnią suszą. Skutecznie usuwamy zbity filc i mech, które duszą korzenie trawy, wykonujemy głęboką aerację napowietrzającą, piaskowanie oraz dosiewkę nasion traw gazonowych. Na koniec stosujemy dedykowane, wolno uwalniające się nawozy.",
    features: [
      "Wertykulacja mechaniczna – usunięcie obumarłego filcu, mchu i płytkich chwastów",
      "Głęboka aeracja rurkowa – napowietrzenie i rozluźnienie zbitego podłoża",
      "Dosiewka regeneracyjna z nasionami odpornymi na deptanie i suszę",
      "Dobór i profesjonalny wysiew nawozów mineralnych z mikroelementami",
      "Regulacja pH gleby (wapnowanie) oraz porady dotyczące dalszego nawadniania"
    ],
    images: [trawnikSrc, kosiaraSrc, anthonySrc]
  },
  {
    title: "Porządkowanie i karczowanie zarośniętych działek",
    slug: "porzadkowanie-dzialek",
    badge: "Przygotowanie terenu",
    icon: "🚜",
    shortDescription: "Usuwanie dzikich samosiewów, chaszczy, zarośli i przygotowanie terenu pod budowę, ogród lub inwestycję.",
    description: "Podejmujemy się najtrudniejszych zadań na zapuszczonych i dziko zarośniętych parcelach. Posiadamy mocne karczownice bijakowe, które bez problemu radzą sobie z gęstą roślinnością o wysokości nawet do 2 metrów. Ścinamy dzikie samosiewy, karczujemy pnie, a pozyskane gałęzie mielimy mobilnym rębakiem. Zapewniamy całkowity wywóz urobku lub pozostawienie wartościowej zrębki do ściółkowania.",
    features: [
      "Wykaszanie gęstych chaszczy, jeżyn i traw kosiarkami karczowniczymi",
      "Wycinka dzikich drzew, samosiewów i przerośniętych zarośli",
      "Rębakowanie gałęzi o średnicy do 15 cm na miejscu u klienta",
      "Frezowanie i karczowanie pni po ściętych drzewach",
      "Kompleksowy wywóz biomasy lub rozrzucenie zrębki na działce"
    ],
    images: [porzadkowanieSrc, dzialkaPrzedPoSrc, kosiaraSrc]
  },
  {
    title: "Przygotowanie działek pod sprzedaż (Home Staging)",
    slug: "przygotowanie-pod-sprzedaz",
    badge: "Szybka metamorfoza",
    icon: "🏡",
    shortDescription: "Ekspresowe podniesienie walorów wizualnych nieruchomości przed przyjazdem potencjalnych kupców.",
    description: "Kupujący kupują oczami. Zarośnięta chwastami działka sprawia wrażenie zaniedbanej i stwarza obawę ogromnych kosztów doprowadzenia jej do ładu. W 1-2 dni diametralnie zmieniamy wygląd terenu: wyrównujemy trawniki, odsłaniamy granice posesji, formujemy krzewy i usuwamy śmieci. Nieruchomość zyskuje na wartości, a czas znalezienia kupca ulega znacznemu skróceniu.",
    features: [
      "Dokładne wykoszenie całej powierzchni i czyszczenie obrzeży przy ogrodzeniach",
      "Wycinka zasłaniających widok dzikich odrostów i samosiewów",
      "Formowanie przerośniętych żywopłotów i drzew owocowych",
      "Uprzątnięcie zalegających suchych gałęzi, zeschłych liści i odpadów",
      "Odsłonięcie walorów przestrzennych i punktów granicznych posesji"
    ],
    images: [dzialkaPrzedPoSrc, porzadkowanieSrc, trawnikSrc]
  },
  {
    title: "Formowanie żywopłotów, cięcie drzew i krzewów",
    slug: "ciecie-drzew-i-krzewow",
    badge: "Pielęgnacja roślin",
    icon: "✂️",
    shortDescription: "Precyzyjne cięcia sanitarne, korygujące, odmładzające oraz geometryczne modelowanie tui i krzewów.",
    description: "Prawidłowo wykonane cięcie decyduje o kondycji, zagęszczeniu oraz odporności roślin na choroby grzybowe. Dbamy o przestrzeganie optymalnych terminów cięć dla poszczególnych gatunków. Wykonujemy formowanie żywopłotów z tui, grabów czy buków z użyciem laserowych prowadnic, co gwarantuje perfekcyjną linię cięcia.",
    features: [
      "Równanie i obniżanie żywopłotów z tui, buków, grabów i ligustru",
      "Cięcia sanitarne – eliminacja suchych, chorych i połamanych konarów",
      "Prześwietlanie i cięcia odmładzające starych drzew i krzewów owocowych",
      "Dezynfekcja narzędzi tnących i zabezpieczanie ran maścią ogrodniczą",
      "Uprzątnięcie i wywóz wszystkich ściętych gałęzi"
    ],
    images: [claudeSrc, trawnikSrc, anthonySrc]
  }
];

const servicesList: ServiceItem[] = (sanityUslugi && sanityUslugi.length > 0)
  ? sanityUslugi.map((item: any) => {
      const allImgs: string[] = [];
      const mainImgSrc = getImgSrc(item.image);
      if (mainImgSrc) allImgs.push(mainImgSrc);

      if (item.gallery && Array.isArray(item.gallery)) {
        item.gallery.forEach((gImg: any) => {
          const gSrc = getImgSrc(gImg);
          if (gSrc && !allImgs.includes(gSrc)) {
            allImgs.push(gSrc);
          }
        });
      }

      if (allImgs.length === 0) allImgs.push(trawnikSrc);
      while (allImgs.length < 3) {
        if (!allImgs.includes(trawnikSrc)) allImgs.push(trawnikSrc);
        else if (!allImgs.includes(porzadkowanieSrc)) allImgs.push(porzadkowanieSrc);
        else allImgs.push(kosiaraSrc);
      }

      return {
        title: item.title || 'Usługa ogrodnicza',
        slug: item.slug || 'usluga',
        badge: item.badge || 'Sezonowa usługa',
        icon: item.icon || '🌿',
        shortDescription: item.shortDescription || 'Kompleksowe usługi ogrodnicze dla Twojego ogrodu.',
        description: item.description || 'Profesjonalna realizacja prac ogrodowych z użyciem profesjonalnego sprzętu.',
        features: (item.features && item.features.length > 0) ? item.features : [
          "Bezpłatna wycena i dojazd na działkę",
          "Własny park maszynowy i doświadczona ekipa",
          "Szybka realizacja i pełny porządek po pracach"
        ],
        images: allImgs.slice(0, 3)
      };
    })
  : fallbackUslugi;
---

<Layout 
  title="Usługi ogrodnicze i pielęgnacja działek | Ogrody Relaks" 
  description="Poznaj pełną ofertę usług Ogrody Relaks: pielęgnacja i regeneracja trawników, karczowanie działek, przygotowanie posesji pod sprzedaż oraz cięcie drzew i żywopłotów. Darmowa wycena pod Warszawą."
>
  <div class="services-page">
    
    <!-- HERO STRONY USŁUG -->
    <header class="page-hero">
      <div class="hero-container">
        <nav class="breadcrumb" aria-label="Ścieżka nawigacyjna">
          <a href="/">Strona Główna</a>
          <span class="sep" aria-hidden="true">/</span>
          <span class="curr" aria-current="page">Oferta usług</span>
        </nav>

        <span class="hero-kicker">
          <span class="kicker-dot" aria-hidden="true"></span>
          PEŁNA OFERTA OGRODY RELAKS
        </span>

        <h1 class="hero-heading">
          Wszystko, czego potrzebuje Twój <span class="italic-highlight">ogród</span>
        </h1>

        <p class="hero-lead">
          Świadczymy kompleksowe usługi ogrodnicze i porządkowe w rejonach pod Warszawą (Pniewy, Tarczyn, Grójec, Piaseczno i okolice). Zapewniamy własny profesjonalny sprzęt, terminowość i w 100% bezpłatną wycenę na Twojej działce.
        </p>

        <!-- KAFELKI ZALET / TRUST PILLS -->
        <div class="trust-pills">
          <div class="pill">
            <span class="pill-check">✓</span>
            <span>Wycena na działce: <strong>Darmowa (0 zł)</strong></span>
          </div>
          <div class="pill">
            <span class="pill-check">✓</span>
            <span>Własny park maszynowy (rębaki, karczownice)</span>
          </div>
          <div class="pill">
            <span class="pill-check">✓</span>
            <span>Utylizacja i wywóz biomasy</span>
          </div>
          <div class="pill">
            <span class="pill-check">✓</span>
            <span>Szybkie terminy realizacji</span>
          </div>
        </div>
      </div>
    </header>

    <!-- GŁÓWNA SIATKA KAFELKÓW (ZAINSPIRYWANA DOKŁADNIE ZE ZRZUTU EKRANU) -->
    <section class="cards-showcase-section">
      <div class="container">
        
        <div class="section-title-bar">
          <div>
            <span class="sub-kicker">PRZEGLĄD DOSTĘPNYCH OPCJI</span>
            <h2 class="sub-heading">Wybierz usługę dopasowaną do Twoich potrzeb</h2>
          </div>
          <a href="/#rezerwacja" class="btn-top-booking">
            <span>Zarezerwuj termin w kalendarzu</span>
            <span class="arrow">&rarr;</span>
          </a>
        </div>

        <!-- SIATKA KART WIZUALNYCH (DOKŁADNIE JAK NA SCREENIE UŻYTKOWNIKA) -->
        <div class="screenshot-cards-grid">
          {servicesList.map((service, index) => (
            <div class="card-visual" id={`card-${service.slug}`}>
              <!-- TŁO ZDJĘCIOWE -->
              <img 
                src={service.images[0]} 
                alt={service.title} 
                class="card-bg-img"
                loading={index < 2 ? "eager" : "lazy"}
              />
              <div class="card-gradient-overlay" aria-hidden="true"></div>

              <!-- GÓRNY PASEK KARTY: ETYKIETA + IKONA / PODGLĄD -->
              <div class="card-top-bar">
                <span class="badge-pill">{service.badge}</span>
                <button 
                  type="button" 
                  class="round-icon-badge gallery-trigger" 
                  data-gallery={JSON.stringify(service.images)}
                  data-index="0"
                  data-title={service.title}
                  data-desc={service.description}
                  data-icon={service.icon}
                  data-badge={service.badge}
                  title="Kliknij, aby otworzyć galerię zdjęć"
                  aria-label={`Powiększ zdjęcia dla usługi: ${service.title}`}
                >
                  <span>{service.icon}</span>
                </button>
              </div>

              <!-- DOLNA TREŚĆ KARTY: TYTUŁ, KRÓTKI OPIS, PRZYCISK -->
              <div class="card-bottom-content">
                <h3 class="card-title">{service.title}</h3>
                <p class="card-desc">{service.shortDescription}</p>
                
                <div class="card-actions">
                  <a href={`#szczegoly-${service.slug}`} class="btn-learn-more">
                    <span>Zobacz szczegóły</span>
                    <span class="arrow-diag" aria-hidden="true">↘</span>
                  </a>
                  <a href="/#rezerwacja" class="btn-quick-quote" title="Zarezerwuj bezpłatną wycenę">
                    <span>Wycena (0 zł)</span>
                    <span class="arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- SZCZEGÓŁOWE OMÓWIENIE KAŻDEJ USŁUGI Z PEŁNĄ GALERIĄ 3 ZDJĘĆ -->
    <section class="detailed-services-section">
      <div class="container">
        
        <div class="details-section-intro">
          <span class="sub-kicker">KOMPLETNE INFORMACJE I GALERIE</span>
          <h2 class="sub-heading">Szczegółowy zakres prac dla każdej usługi</h2>
          <p class="intro-p">Kliknij w interesującą Cię pozycję, aby zapoznać się ze sprzętem, etapami prac oraz galeriami zdjęć z naszych realizacji.</p>
        </div>

        <div class="services-deep-list">
          {servicesList.map((service, index) => {
            const isReversed = index % 2 === 1;
            return (
              <article 
                class={`service-deep-item ${isReversed ? 'is-reversed' : ''}`}
                id={`szczegoly-${service.slug}`}
              >
                <!-- KOLUMNA TEKSTOWA -->
                <div class="deep-text-side">
                  <div class="deep-meta">
                    <span class="deep-badge">{service.badge}</span>
                    <span class="deep-index">Usługa #{index + 1}</span>
                  </div>

                  <h3 class="deep-title">
                    <span class="deep-icon-inline" aria-hidden="true">{service.icon}</span>
                    {service.title}
                  </h3>

                  <p class="deep-paragraph">{service.description}</p>

                  <div class="features-checklist-card">
                    <h4 class="checklist-heading">Co dokładnie wchodzi w zakres tej usługi:</h4>
                    <ul class="checklist">
                      {service.features.map((feature) => (
                        <li>
                          <span class="check-mark" aria-hidden="true">✓</span>
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="pricing-guarantee-note">
                    <div class="note-icon">💡</div>
                    <div class="note-text">
                      <strong>Darmowa wycena i konsultacja na działce:</strong>
                      <span>Przyjedziemy, dokonamy oględzin i bezpłatnie oszacujemy koszty przed rozpoczęciem jakichkolwiek prac.</span>
                    </div>
                  </div>

                  <div class="deep-actions">
                    <a href="/#rezerwacja" class="deep-btn-primary">
                      <span>Zarezerwuj tę usługę w kalendarzu</span>
                      <span class="arrow">&rarr;</span>
                    </a>
                    <a href="tel:+48535262302" class="deep-btn-phone">
                      <span>Zadzwoń: +48 535 262 302</span>
                    </a>
                  </div>
                </div>

                <!-- KOLUMNA GALERII 3 ZDJĘĆ -->
                <div class="deep-gallery-side">
                  <div class="gallery-label-bar">
                    <span class="gallery-title">Galeria realizacji (3 ujęcia)</span>
                    <span class="gallery-badge-small">{service.icon} Zdjęcia z terenu</span>
                  </div>

                  <div class="deep-gallery-grid">
                    <!-- GŁÓWNE ZDJĘCIE (DUŻE) -->
                    <div 
                      class="photo-main-box gallery-trigger"
                      data-gallery={JSON.stringify(service.images)}
                      data-index="0"
                      data-title={service.title}
                      data-desc={service.description}
                      data-icon={service.icon}
                      data-badge={service.badge}
                      title="Kliknij, aby powiększyć zdjęcie"
                      role="button"
                      tabindex="0"
                    >
                      <img 
                        src={service.images[0]} 
                        alt={`${service.title} - ujęcie główne`}
                        loading="lazy"
                      />
                      <span class="photo-tag">Widok główny</span>
                      <span class="photo-zoom-hint" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                      </span>
                    </div>

                    <!-- 2 ZDJĘCIA MNIEJSZE -->
                    <div 
                      class="photo-sub-box gallery-trigger"
                      data-gallery={JSON.stringify(service.images)}
                      data-index="1"
                      data-title={service.title}
                      data-desc={service.description}
                      data-icon={service.icon}
                      data-badge={service.badge}
                      title="Kliknij, aby powiększyć zdjęcie"
                      role="button"
                      tabindex="0"
                    >
                      <img 
                        src={service.images[1]} 
                        alt={`${service.title} - ujęcie 2`}
                        loading="lazy"
                      />
                      <span class="photo-tag">Proces prac</span>
                      <span class="photo-zoom-hint" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                      </span>
                    </div>

                    <div 
                      class="photo-sub-box gallery-trigger"
                      data-gallery={JSON.stringify(service.images)}
                      data-index="2"
                      data-title={service.title}
                      data-desc={service.description}
                      data-icon={service.icon}
                      data-badge={service.badge}
                      title="Kliknij, aby powiększyć zdjęcie"
                      role="button"
                      tabindex="0"
                    >
                      <img 
                        src={service.images[2]} 
                        alt={`${service.title} - ujęcie 3`}
                        loading="lazy"
                      />
                      <span class="photo-tag">Efekt końcowy</span>
                      <span class="photo-zoom-hint" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                      </span>
                    </div>
                  </div>
                </div>

              </article>
            );
          })}
        </div>

      </div>
    </section>

    <!-- DOLNA SEKCJA CTA / KONTAKTOWA -->
    <section class="bottom-cta-banner">
      <div class="container">
        <div class="cta-inner-card">
          <div class="cta-text">
            <span class="cta-badge">SZYBKI KONTAKT I KONSULTACJA</span>
            <h2>Nie wiesz, jakiego zakresu prac potrzebujesz?</h2>
            <p>
              Skontaktuj się z nami telefonicznie lub wybierz dzień w naszym kalendarzu na stronie głównej. Odpowiemy na wszystkie pytania i dobierzemy optymalny pakiet usług dla Twojego ogrodu.
            </p>
          </div>

          <div class="cta-buttons">
            <a href="/#rezerwacja" class="cta-btn-main">
              <span>Przejdź do kalendarza spotkań</span>
              <span class="arrow">&rarr;</span>
            </a>
            <a href="tel:+48535262302" class="cta-btn-alt">
              <span>+48 535 262 302</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- LIGHTBOX / PODGLĄD ZDJĘCIA USŁUGI -->
    <div id="service-lightbox" class="service-lightbox" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="lightbox-backdrop"></div>
      <div class="lightbox-container">
        <button id="lightbox-close" class="lightbox-close" aria-label="Zamknij podgląd" title="Zamknij (Esc)">&times;</button>
        
        <div class="lightbox-media">
          <button id="lightbox-prev" class="lightbox-nav prev" aria-label="Poprzednie zdjęcie" title="Poprzednie">&#10094;</button>
          <img id="lightbox-img" src="" alt="Podgląd zdjęcia usługi" />
          <button id="lightbox-next" class="lightbox-nav next" aria-label="Następne zdjęcie" title="Następne">&#10095;</button>
          <div id="lightbox-counter" class="lightbox-counter">1 / 3</div>
        </div>

        <div class="lightbox-details">
          <div>
