---
import NavbarDesktop from '../components/Navbars/NavbarDesktop.astro';
import NavbarMobile from '../components/Navbars/NavbarMobile.astro';

---
<!doctype html>

<html lang="en">
	<head>
		
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
        <header id="Desktop">
            <NavbarDesktop />
        </header>

        <header id="Mobile">
            <NavbarMobile />
        </header>
		<main>
			<slot />
		</main>
		
	</body>

</html>
M.astro
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

	html,
    body {
        font-family: 'Inter', sans-serif;
        background: white;
        margin: 0;
        width: 100%;
        min-height: 100vh;
    }
	
		/* Domyślnie ukryty na telefonach */
	#Desktop {
		display: none;
	}

	#Mobile{
		display: block;
	}

	/* Pokazuje się tylko od 768px w górę */
	@media (min-width: 1024px) {
		#Desktop {
			display: flex;
			min-width: 1024px;
		}

		#Mobile{
			display: none;
		}
	}

</style>
