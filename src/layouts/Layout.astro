---
import NavbarDesktop from '../components/Navbars/NavbarDesktop.astro';
import NavbarMobile from '../components/Navbars/NavbarMobile.astro';
---
<!doctype html>
<html lang="pl">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Ogrody Relaks</title>
    </head>
    <body>
        <header id="Desktop">
            <NavbarDesktop />
        </header>

        <header id="Mobile">
            <NavbarMobile />
        </header>

        <main>
            <slot />
        </main>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const desktop = document.getElementById('Desktop');
                const mobile = document.getElementById('Mobile');
                
                const handleScroll = () => {
                    if (window.scrollY > 20) {
                        desktop?.classList.add('is-scrolled');
                        mobile?.classList.add('is-scrolled');
                    } else {
                        desktop?.classList.remove('is-scrolled');
                        mobile?.classList.remove('is-scrolled');
                    }
                };

                window.addEventListener('scroll', handleScroll);
                handleScroll(); // Inicjalizacja przy ładowaniu
            });
        </script>
    </body>
</html>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    *, *::before, *::after {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth; 
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: #fdfdfd; 
        color: #1a1a1a;
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased; 
        -moz-osx-font-smoothing: grayscale;
    }

    main {
        position: relative;
        margin: 0 auto;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    #Desktop, 
    #Mobile {
        position: fixed;
        left: 0;
        right: 0;
        z-index: 50;
        pointer-events: none; 
        width: 100%;
        transition: top 0.4s ease-in-out; /* Płynne oderwanie od sufitu */
    }

    #Desktop {
        top: 0; /* Domyślnie przyklejony do krawędzi */
    }

    #Mobile {
        top: 0;
    }

    /* Pozycje po rozpoczęciu przewijania */
    #Desktop.is-scrolled {
        top: 1.5rem;
    }

    #Mobile.is-scrolled {
        top: 0.5rem;
    }

    #Desktop :global(nav),
    #Desktop :global(div),
    #Mobile :global(nav),
    #Mobile :global(div) {
        pointer-events: auto;
    }

    #Desktop {
        display: none;
    }

    #Mobile {
        display: block;
    }

    @media (max-width: 1024px) {
        main {
            width: 100%;
        }
    }

    @media (min-width: 1024px) {
        #Desktop {
            display: flex;
            justify-content: center; 
        }

        #Mobile {
            display: none;
        }

        main {
            width: 100%; 
            max-width: 1440px; 
        }
    }
</style>