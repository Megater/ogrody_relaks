---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sanityClient } from 'sanity:client';
import imageUrlBuilder from '@sanity/image-url';
import trawnik from '../../assets/images/Realizacje/trawnik.jpg';
import dzialkaPrzedPo from '../../assets/images/Realizacje/dzialka_przed_po.jpg';
import porzadkowanie from '../../assets/images/Realizacje/porzadkowanie_dzialki.jpg';
import viewGardenImg from '../../assets/images/view_garden_done.jpg';
import ciagnikImg from '../../assets/images/ciagnik_koszenie.jpg';
import grassPartsImg from '../../assets/images/grass_parts.jpg';

// Interfejs dla TypeScriptu (usuwa podkreślanie 'item' w HTML-u)
interface RealizacjaItem {
  title: string;
  description: string;
  icon: string;
  image: string | ImageMetadata;
  href: string;
}

// Konfiguracja buildera do wyciągania zoptymalizowanych linków ze zdjęć Sanity
const builder = imageUrlBuilder(sanityClient);
function urlFor(source: any) {
  return builder.image(source);
}

// 1. Pobieranie danych z Sanity (sortowane od najnowszych)
let sanityRealizacje: any[] = [];
try {
  sanityRealizacje = await sanityClient.fetch(`
    *[_type == "realizacja"] | order(_createdAt desc) {
      title,
      description,
      icon,
      "slug": slug.current,
      image
    }
  `);
} catch (error) {
  console.warn("Błąd pobierania z Sanity lub brak konfiguracji – używam danych zastępczych.");
}

// 2. Dane zastępcze (działają, dopóki nie dodasz projektów w /studio)
const fallbackRealizacje: RealizacjaItem[] = [
  {
    title: "Przygotowanie działki pod sprzedaż",
    description: "Wykoszenie gęstych zarośli, usunięcie samosiewów i wyrównanie przerośniętego żywopłotu.",
    icon: "🚜", 
    image: dzialkaPrzedPo,
    href: "/realizacje"
  },
  {
    title: "Porządkowanie i karczowanie posesji",
    description: "Kompleksowe oczyszczenie mocno zarośniętego terenu pod inwestycję i budowę.",
    icon: "🌲",
    image: porzadkowanie,
    href: "/realizacje"
  },
  {
    title: "Pielęgnacja trawników",
    description: "Zdrowe, zielone trawniki przez cały rok. Koszenie, aeracja i nawożenie.",
    icon: "🌱", 
    image: trawnik,
    href: "/realizacje"
  },
  {
    title: "Projektowanie ogrodów",
    description: "Piękne ogrody, w których chce się przebywać.",
    icon: "🌿",
    image: viewGardenImg,
    href: "/realizacje"
  },
  {
    title: "Strefy wypoczynkowe",
    description: "Patio, tarasy, paleniska i pergole.",
    icon: "🛋️",
    image: ciagnikImg,
    href: "/realizacje"
  },
  {
    title: "Systemy nawadniania",
    description: "Wydajne podlewanie i automatyczne zraszacze.",
    icon: "💧",
    image: grassPartsImg,
    href: "/realizacje"
  }
];

// 3. Mapowanie danych z Sanity na format naszych kart (WebP + niższa waga)
const mappedSanity: RealizacjaItem[] = sanityRealizacje.map((item: any) => ({
  title: item.title,
  description: item.description,
  icon: item.icon || "🌿",
  // Karta w wagoniku ma 340px szerokości, więc 600x420 w WebP (jakość 75%) w zupełności wystarczy
  image: item.image 
    ? urlFor(item.image).width(600).height(420).format('webp').quality(75).url() 
    : "",
  href: "/realizacje"
}));

const activeList: RealizacjaItem[] = mappedSanity.length > 0 ? mappedSanity : fallbackRealizacje;

const realizacje: RealizacjaItem[] = activeList.length < 5 
  ? [...activeList, ...activeList, ...activeList] 
  : activeList;
---

<section class="realizacje-section" id="realizacje">
  <div class="container">
    <div class="section-header">
      <div class="header-left">
        <span class="kicker">
          <span class="kicker-dot" aria-hidden="true"></span>
          NASZE REALIZACJE
        </span>
        <h2 class="title">
          Efekty i metamorfozy <span class="italic-highlight">w obiektywie</span>
        </h2>
      </div>
      <div class="header-right">
        <p class="subtitle">
          Zobacz rzeczywiste realizacje prac terenowych, pielęgnacji trawników i porządkowania działek w rejonach pod Warszawą.
        </p>
        <a href="/realizacje" class="view-all-link">
          <span>Zobacz wszystkie realizacje</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <div class="slider-wrapper" id="realizacjeSlider">
    <div class="slider-inner" id="sliderInner">
      <!-- Wagonik 1 -->
      <div class="slider-track" data-track="1">
        {realizacje.map((item) => (
          <a href="/realizacje" class="card" draggable="false">
            <div class="card-image-wrapper">
              {typeof item.image === 'string' ? (
                <img src={item.image} alt={item.title} class="card-img" loading="lazy" draggable="false" width="600" height="420" />
              ) : (
                <Image src={item.image} alt={item.title} class="card-img" draggable="false" width={600} height={420} format="webp" quality={75} />
              )}
              <div class="card-icon" aria-hidden="true">{item.icon}</div>
            </div>
            <div class="card-content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <div class="card-link-more">
                <span>Zobacz realizację</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Wagonik 2 (Kopia do nieskończonej pętli) -->
      <div class="slider-track" aria-hidden="true" data-track="2">
        {realizacje.map((item) => (
          <a href="/realizacje" class="card" tabindex="-1" draggable="false">
            <div class="card-image-wrapper">
              {typeof item.image === 'string' ? (
                <img src={item.image} alt={item.title} class="card-img" loading="lazy" draggable="false" width="600" height="420" />
              ) : (
                <Image src={item.image} alt={item.title} class="card-img" draggable="false" width={600} height={420} format="webp" quality={75} />
              )}
              <div class="card-icon" aria-hidden="true">{item.icon}</div>
            </div>
            <div class="card-content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <div class="card-link-more">
                <span>Zobacz realizację</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Wagonik 3 (Kopia do płynnego przewijania w obie strony na każdym ekranie) -->
      <div class="slider-track" aria-hidden="true" data-track="3">
        {realizacje.map((item) => (
          <a href="/realizacje" class="card" tabindex="-1" draggable="false">
            <div class="card-image-wrapper">
              {typeof item.image === 'string' ? (
                <img src={item.image} alt={item.title} class="card-img" loading="lazy" draggable="false" width="600" height="420" />
              ) : (
                <Image src={item.image} alt={item.title} class="card-img" draggable="false" width={600} height={420} format="webp" quality={75} />
              )}
              <div class="card-icon" aria-hidden="true">{item.icon}</div>
            </div>
            <div class="card-content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <div class="card-link-more">
                <span>Zobacz realizację</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .realizacje-section {
    padding: 100px 0;
    background-color: #f8faf8;
    overflow: hidden;
    font-family: 'Inter', sans-serif;
    width: 100%;
    box-sizing: border-box;
  }

  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* --- NAGŁÓWEK SEKCJI W SPÓJNYM STYLU --- */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 50px;
    width: 100%;
    box-sizing: border-box;
  }

  .header-left {
    max-width: 640px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #86b942;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 14px;
  }

  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #86b942;
    display: inline-block;
  }

  .title {
    font-size: clamp(2.1rem, 4.5vw, 3.2rem);
    font-weight: 800;
    color: #153c24;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .italic-highlight {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 600;
    color: #86b942;
  }

  .header-right {
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #556960;
    margin: 0;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #153c24;
    text-decoration: none;
    transition: all 0.25s ease;
    border-bottom: 2px solid rgba(134, 185, 66, 0.4);
    padding-bottom: 2px;
  }

  .view-all-link:hover {
    color: #86b942;
    border-color: #86b942;
    transform: translateX(4px);
  }

  .view-all-link .arrow {
    transition: transform 0.2s ease;
  }

  .view-all-link:hover .arrow {
    transform: translate(2px, -2px);
  }

  /* --- WAGONIKI SLIDER --- */
  .slider-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 20px 0 40px 0;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }

  .slider-wrapper.is-dragging {
    cursor: grabbing;
  }

  .slider-inner {
    display: flex;
    gap: 24px;
    width: max-content;
    will-change: transform;
  }

  .slider-track {
    display: flex;
    gap: 24px;
    flex-shrink: 0;
    width: max-content;
  }

  /* --- KARTA WAGONIKA --- */
  .card {
    width: 350px;
    flex: 0 0 350px; 
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid rgba(12, 43, 32, 0.08);
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 18px rgba(12, 43, 32, 0.04);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.35s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    cursor: pointer;
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 18px 36px rgba(12, 43, 32, 0.1);
      border-color: rgba(134, 185, 66, 0.45);
    }
  }

  .card-image-wrapper {
    position: relative;
    height: 230px;
    overflow: hidden;
    background-color: #eef6e8;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    -webkit-user-drag: none;
    user-drag: none;
    display: block;
  }

  .card:hover .card-img {
    transform: scale(1.06);
  }

  .card-image-wrapper::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(12, 43, 32, 0.35), transparent);
    pointer-events: none;
  }

  .card-icon {
    position: absolute;
    bottom: 14px;
    left: 18px;
    width: 48px;
    height: 48px;
    background: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    box-shadow: 0 6px 16px rgba(12, 43, 32, 0.14);
    z-index: 2;
    transition: transform 0.3s ease;
    pointer-events: none;
    border: 2px solid #eef6e8;
  }

  .card:hover .card-icon {
    transform: scale(1.08);
  }

  .card-content {
    padding: 24px 22px 22px 22px; 
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
  }

  .card-content h3 {
    font-size: 1.22rem;
    color: #153c24;
    margin: 0;
    font-weight: 700;
    line-height: 1.35;
  }

  .card-content p {
    font-size: 0.92rem;
    color: #556960;
    margin: 0;
    line-height: 1.55;
    flex-grow: 1;
  }

  .card-link-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 0.88rem;
    font-weight: 700;
    color: #153c24;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .card:hover .card-link-more {
    color: #86b942;
  }

  .card-link-more .arrow {
    transition: transform 0.2s ease;
  }

  .card:hover .card-link-more .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 960px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 35px;
    }
    .header-right {
      max-width: 100%;
    }
    .card {
      width: 290px;
      flex: 0 0 290px; 
    }
    .card-image-wrapper {
      height: 195px;
    }
  }
</style>

<script>
  function initRealizacjeSlider() {
    const sliderWrapper = document.getElementById('realizacjeSlider');
    const sliderInner = document.getElementById('sliderInner');
    if (!sliderWrapper || !sliderInner) return;

    // Unikamy podwójnej inicjalizacji przy Astro page transitions
    if ((sliderWrapper as any)._sliderInitialized) return;
    (sliderWrapper as any)._sliderInitialized = true;

    const tracks = sliderInner.querySelectorAll('.slider-track');
    if (tracks.length < 2) return;

    const track1 = tracks[0] as HTMLElement;
    const track2 = tracks[1] as HTMLElement;

    let singleTrackWidth = 0;
    function updateTrackWidth() {
      const r1 = track1.getBoundingClientRect();
      const r2 = track2.getBoundingClientRect();
      const dist = r2.left - r1.left;
      if (dist > 0) {
        singleTrackWidth = dist;
      }
    }
    updateTrackWidth();

    window.addEventListener('resize', updateTrackWidth);
    window.addEventListener('load', updateTrackWidth);
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => updateTrackWidth());
      ro.observe(sliderInner);
    }

    let currentX = 0;
    let isDragging = false;
    let isWheeling = false;
    let isCardHovered = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragStartCurrentX = 0;
    let lastDragX = 0;
    let lastDragTime = performance.now();
    let dragVelocity = 0;
    let inertiaVelocity = 0;
    let isHorizontalDrag: boolean | null = null;
    let isMoved = false;
    const DRAG_THRESHOLD = 15;
    let wheelTimeout: any = null;

    // Prędkość domyślna: pełny obieg w 35s (zgodnie z oryginalną animacją)
    const BASE_LOOP_SECONDS = 35;

    // Wykrywanie hover tylko dla precyzyjnego wskaźnika (mysz komputerowa, nie telefon)
    const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // Zatrzymujemy auto-przesuwanie przy najechaniu na kartę oraz obsługujemy pojedyncze kliknięcie
    const cards = sliderInner.querySelectorAll('.card');
    cards.forEach((card) => {
      if (isFinePointer) {
        card.addEventListener('mouseenter', () => {
          isCardHovered = true;
        });
        card.addEventListener('mouseleave', () => {
          isCardHovered = false;
        });
      }

      // Gwarancja natychmiastowego przejścia na /realizacje po pojedynczym kliknięciu
      card.addEventListener('click', (e: Event) => {
        if (isMoved) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        const mouseEv = e as MouseEvent;
        if (mouseEv.button !== 0 || mouseEv.ctrlKey || mouseEv.metaKey || mouseEv.shiftKey) return;
        window.location.href = '/realizacje';
      });
    });

    function normalizeCurrentX() {
      if (singleTrackWidth <= 0) return;
      while (currentX > 0) currentX -= singleTrackWidth;
      while (currentX <= -singleTrackWidth) currentX += singleTrackWidth;
    }

    function applyTransform() {
      sliderInner.style.transform = `translate3d(${currentX}px, 0, 0)`;
    }

    // 1. OBSŁUGA DOTYKU NA TELEFONIE (SWIPE / DRAG PALCEM LEWO-PRAWO)
    sliderWrapper.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length !== 1) return;
      isDragging = true;
      isMoved = false;
      isHorizontalDrag = null;
      dragStartX = e.touches[0].clientX;
      dragStartY = e.touches[0].clientY;
      dragStartCurrentX = currentX;
      lastDragX = dragStartX;
      lastDragTime = performance.now();
      dragVelocity = 0;
      inertiaVelocity = 0;
    }, { passive: true });

    sliderWrapper.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isDragging || e.touches.length !== 1) return;
      const clientX = e.touches[0].clientX;
      const clientY = e.touches[0].clientY;
      const dx = clientX - dragStartX;
      const dy = clientY - dragStartY;
      const dist = Math.hypot(dx, dy);

      // Rozpoznajemy intencję: scroll pionowy strony vs przesunięcie poziome wagoników
      if (isHorizontalDrag === null) {
        if (dist > 8) {
          isHorizontalDrag = Math.abs(dx) >= Math.abs(dy);
          if (!isHorizontalDrag) {
            isDragging = false;
            return;
          }
        } else {
          return;
        }
      }

      if (isHorizontalDrag) {
        // Blokujemy pionowy scroll strony, gdy użytkownik przesuwa wagoniki poziomo
        if (e.cancelable) e.preventDefault();

        if (dist > DRAG_THRESHOLD) {
          isMoved = true;
        }

        const now = performance.now();
        const dt = now - lastDragTime;
        if (dt > 10) {
          dragVelocity = (clientX - lastDragX) / (dt / 1000);
          lastDragX = clientX;
          lastDragTime = now;
        }

        currentX = dragStartCurrentX + dx;
        normalizeCurrentX();
        applyTransform();
      }
    }, { passive: false });

    function handleTouchEnd() {
      if (!isDragging) return;
      isDragging = false;
      if (isHorizontalDrag) {
        if (Math.abs(dragVelocity) > 60) {
          inertiaVelocity = dragVelocity;
        } else {
          inertiaVelocity = 0;
        }
      }
      isHorizontalDrag = null;
      setTimeout(() => {
        isMoved = false;
      }, 150);
    }

    sliderWrapper.addEventListener('touchend', handleTouchEnd);
    sliderWrapper.addEventListener('touchcancel', handleTouchEnd);

    // 2. PRZECIĄGANIE MYSZKĄ NA KOMPUTERZE
    sliderWrapper.addEventListener('mousedown', (e: MouseEvent) => {
      if (e.button !== 0) return;
      isDragging = true;
      isMoved = false;
      isHorizontalDrag = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragStartCurrentX = currentX;
      lastDragX = dragStartX;
      lastDragTime = performance.now();
      dragVelocity = 0;
      inertiaVelocity = 0;
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDragging) return;
      const dx = e.clientX - dragStartX;
      const dy = e.clientY - dragStartY;
      const dist = Math.hypot(dx, dy);

      if (dist > DRAG_THRESHOLD) {
        isMoved = true;
        sliderWrapper.classList.add('is-dragging');
      }

      const now = performance.now();
      const dt = now - lastDragTime;
      if (dt > 10) {
        dragVelocity = (e.clientX - lastDragX) / (dt / 1000);
        lastDragX = e.clientX;
        lastDragTime = now;
      }

      currentX = dragStartCurrentX + dx;
      normalizeCurrentX();
      applyTransform();
    });

    window.addEventListener('mouseup', (e: MouseEvent) => {
      if (!isDragging) return;
      isDragging = false;
      sliderWrapper.classList.remove('is-dragging');
      const dist = Math.hypot(e.clientX - dragStartX, e.clientY - dragStartY);
      if (dist <= DRAG_THRESHOLD) {
        isMoved = false;
      }
      if (Math.abs(dragVelocity) > 60) {
        inertiaVelocity = dragVelocity;
      } else {
        inertiaVelocity = 0;
      }
      setTimeout(() => {
        isMoved = false;
      }, 150);
    });

    // 3. OBSŁUGA NA KOMPUTERZE: SHIFT + SCROLL KÓŁKIEM MYSZKI
    sliderWrapper.addEventListener('wheel', (e: WheelEvent) => {
      // Reagujemy, gdy wciśnięty jest Shift LUB gdy kółko/trackpad przekazuje scroll poziomy deltaX
      if (e.shiftKey || Math.abs(e.deltaX) > 0) {
        e.preventDefault();

        // Kółko pionowe z Shiftem może być przekazywane jako deltaY lub deltaX w zależności od systemu
        const delta = Math.abs(e.deltaX) > 0 ? e.deltaX : e.deltaY;

        // Przesuwamy wagoniki zgodnie z ruchem kółka
        currentX -= delta * 1.15;
        normalizeCurrentX();
        applyTransform();

        // Podczas aktywnego scrollowania wstrzymujemy automatyczny ruch
        isWheeling = true;
        clearTimeout(wheelTimeout);
        wheelTimeout = setTimeout(() => {
          isWheeling = false;
        }, 400);
      }
    }, { passive: false });

    // Blokujemy kliknięcie TYLKO wtedy, gdy użytkownik rzeczywiście przeciągał wagonik (>15px)
    sliderWrapper.addEventListener('click', (e: MouseEvent) => {
      if (isMoved) {
        e.preventDefault();
        e.stopPropagation();
      }
    });

    // 4. GŁÓWNA PĘTLA ANIMACJI (REQUEST ANIMATION FRAME)
    let lastFrameTime = performance.now();

    function animate(now: number) {
      const dt = Math.min((now - lastFrameTime) / 1000, 0.1);
      lastFrameTime = now;

      if (!isDragging && !isWheeling) {
        // Płynna inercja po dynamicznym puszczeniu palca
        if (Math.abs(inertiaVelocity) > 20) {
          currentX += inertiaVelocity * dt;
          inertiaVelocity *= Math.pow(0.08, dt); // Płynne tłumienie
          normalizeCurrentX();
          applyTransform();
        } else {
          inertiaVelocity = 0;
          // Automatyczny ruch wagoników, gdy użytkownik nie wchodzi w interakcję
          if (!isCardHovered) {
            const speed = singleTrackWidth > 0 ? singleTrackWidth / BASE_LOOP_SECONDS : 55;
            currentX -= speed * dt;
            normalizeCurrentX();
            applyTransform();
          }
        }
      }

      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
  }

  // Uruchomienie przy załadowaniu strony oraz przy przejściach Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRealizacjeSlider);
  } else {
    initRealizacjeSlider();
  }
  document.addEventListener('astro:page-load', initRealizacjeSlider);
</script>