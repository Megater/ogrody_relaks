---
import { Image } from 'astro:assets';
import trawnik from '../../assets/images/Realizacje/trawnik.jpg'

const realizacje = [
  {
    title: "Pielęgnacja trawników",
    description: "Zdrowe, zielone trawniki przez cały rok.",
    icon: "🌱", 
    image: trawnik,
    href: "/realizacje/pielegnacja-trawnikow"
  },
  {
    title: "Projektowanie ogrodów",
    description: "Piękne ogrody, w których chce się przebywać.",
    icon: "🌿",
    image: "https://images.unsplash.com/photo-1558904541-efa843a96f0f?q=80&w=600&auto=format&fit=crop",
    href: "/realizacje/projektowanie"
  },
  {
    title: "Strefy wypoczynkowe",
    description: "Patio, tarasy, paleniska i wiele więcej.",
    icon: "🛋️",
    image: "https://images.unsplash.com/photo-1605810730434-7631ac76ec81?q=80&w=600&auto=format&fit=crop",
    href: "/realizacje/strefy-wypoczynkowe"
  },
  {
    title: "Architektura twarda",
    description: "Ścieżki, murki oporowe i prace kamieniarskie.",
    icon: "🧱",
    image: "https://images.unsplash.com/photo-1584622650111-993a426fbf0a?q=80&w=600&auto=format&fit=crop",
    href: "/realizacje/architektura"
  },
  {
    title: "Oświetlenie",
    description: "Podkreśl piękno posesji w dzień i w nocy.",
    icon: "💡",
    image: "https://images.unsplash.com/photo-1509641772183-b9247ce96bf4?q=80&w=600&auto=format&fit=crop",
    href: "/realizacje/oswietlenie"
  },
  {
    title: "Systemy nawadniania",
    description: "Wydajne podlewanie dla zielonego jutra.",
    icon: "💧",
    image: "https://images.unsplash.com/photo-1574944985070-8f3ebc6b79d2?q=80&w=600&auto=format&fit=crop",
    href: "/realizacje/nawadnianie"
  }
];
---

<section class="realizacje-section">
  <div class="container">
    <div class="section-header">
      <div class="header-text">
        <h2>NASZE REALIZACJE</h2>
      </div>
      <a href="/realizacje" class="view-all">Zobacz wszystkie realizacje &rarr;</a>
    </div>
  </div>

  <!-- Główny kontener slidera -->
  <div class="slider-wrapper">
    
    <!-- Wagonik 1 -->
    <div class="slider-track">
      {realizacje.map((item) => (
        <a href={item.href} class="card">
            <div class="card-image-wrapper">
            {typeof item.image === 'string' ? (
                <img src={item.image} alt={item.title} class="card-img" loading="lazy" />
            ) : (
                <Image src={item.image} alt={item.title} class="card-img" />
            )}
            <div class="card-icon">{item.icon}</div>
            </div>
        </a>
      ))}
    </div>

    <!-- Wagonik 2 (Kopia zapewniająca płynne przejście) -->
    <div class="slider-track" aria-hidden="true">
      {realizacje.map((item) => (
        <a href={item.href} class="card">
            <div class="card-image-wrapper">
            {typeof item.image === 'string' ? (
                <img src={item.image} alt={item.title} class="card-img" loading="lazy" />
            ) : (
                <Image src={item.image} alt={item.title} class="card-img" />
            )}
            <div class="card-icon">{item.icon}</div>
            </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .realizacje-section {
    padding: 60px 0;
    background-color: #fafafa;
    overflow: hidden;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* --- NAGŁÓWEK --- */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 20px;
  }

  .kicker {
    font-size: 0.85rem;
    font-weight: 700;
    color: #86b942;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 8px;
  }

  .header-text h2 {
    font-size: 2.2rem;
    color: #153c24;
    margin: 0;
  }

  .view-all {
    color: #153c24;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }

  .view-all:hover {
    color: #86b942;
  }

  /* --- PERFEKCYJNE ZAPĘTLENIE --- */
  .slider-wrapper {
    display: flex; /* Ustawia oba wagoniki w jednym rzędzie */
    gap: 25px; /* Odstęp między wagonikami */
    width: 100%;
    overflow: hidden;
    padding: 20px 0; /* Miejsce na cienie kart */
  }

.slider-track {
    display: flex;
    gap: 25px; /* Odstęp między kartami */
    flex-shrink: 0; /* Zapobiega ściskaniu się wagoników */
    
    /* KLUCZOWA ZMIANA: Zmusza wagonik do utrzymania pełnej szerokości */
    width: max-content; 
    
    animation: scroll 35s linear infinite;
  }



  /* Pauza przy najechaniu na dowolny fragment slidera */
  .slider-wrapper:hover .slider-track {
    animation-play-state: paused;
  }
@keyframes scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(calc(-100% - 25px));
  }
}

  /* --- KARTY --- */
  .card {
    /* Ubezpieczenie szerokości karty */
    width: 320px;
    flex: 0 0 320px; 
    
    background: #ffffff;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* Zapobiega "wylewaniu" się elementów z karty */
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
  }

  .card-image-wrapper {
    position: relative;
    height: 220px;
    border-radius: 12px 12px 0 0;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px 12px 0 0;
  }

  .card-icon {
    position: absolute;
    bottom: -25px;
    left: 20px;
    width: 50px;
    height: 50px;
    background: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    z-index: 2;
  }

  .card-content {
    padding: 40px 20px 25px 20px; 
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .card-content h3 {
    font-size: 1.25rem;
    color: #153c24;
    margin: 0 0 10px 0;
  }

  .card-content p {
    font-size: 0.95rem;
    color: #666666;
    margin: 0;
    line-height: 1.5;
  }

  /* Responsywność */
  @media (max-width: 768px) {
    .card {
      flex: 0 0 280px; 
    }
    .header-text h2 {
      font-size: 1.8rem;
    }
  }
</style>