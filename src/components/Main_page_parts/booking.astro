---
// Booking.astro
const monthNames = [
  'Styczeń', 'Luty', 'Marzec', 'Kwiecień', 'Maj', 'Czerwiec',
  'Lipiec', 'Sierpień', 'Wrzesień', 'Październik', 'Listopad', 'Grudzień'
];
const monthNamesGenitiveSSR = [
  'stycznia', 'lutego', 'marca', 'kwietnia', 'maja', 'czerwca',
  'lipca', 'sierpnia', 'września', 'października', 'listopada', 'grudnia'
];
const dayNamesPlSSR = [
  'Niedziela', 'Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek', 'Sobota'
];

const now = new Date();
const currentYear = now.getFullYear();
const currentMonth = now.getMonth();
const currentDay = now.getDate();
const currentMonthName = monthNames[currentMonth];

const dayNamesList = ['Pn.', 'Wt.', 'Śr.', 'Cz.', 'Pt.', 'So.', 'Nd.'];

// Przesunięcie pierwszego dnia tygodnia (Pn = 0, ..., Nd = 6)
const firstDayOfMonth = new Date(currentYear, currentMonth, 1).getDay();
const startOffsetSSR = (firstDayOfMonth + 6) % 7;
const totalDaysInCurrMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

// Domyślnie wybrany dzień (pierwszy wolny dzień roboczy od dzisiaj)
let defaultSelectedDay = 0;
for (let d = currentDay; d <= totalDaysInCurrMonth; d++) {
  const dow = new Date(currentYear, currentMonth, d).getDay();
  if (dow !== 0 && dow !== 6) {
    defaultSelectedDay = d;
    break;
  }
}
const initialDateObj = defaultSelectedDay ? new Date(currentYear, currentMonth, defaultSelectedDay) : null;
const initialDayName = initialDateObj ? dayNamesPlSSR[initialDateObj.getDay()] : '';
const initialSelectedText = defaultSelectedDay ? `${initialDayName}, ${defaultSelectedDay} ${monthNamesGenitiveSSR[currentMonth]} ${currentYear}` : 'Wybierz dzień z kalendarza powyżej';
const initialSelectedDateStr = defaultSelectedDay ? `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(defaultSelectedDay).padStart(2, '0')}` : '';
const initialFooterDateText = defaultSelectedDay ? `${defaultSelectedDay} ${monthNamesGenitiveSSR[currentMonth]} ${currentYear}` : '—';
---

<section class="booking-section" id="rezerwacja">
  <div class="container">
    <div class="booking-grid">
      
      <!-- LEWA KOLUMNA: Informacje -->
      <div class="booking-info">
        <span class="kicker">
          <span class="kicker-dot" aria-hidden="true"></span>
          ZACZNIJMY OD SPOTKANIA
        </span>
        <h2>Twój ogród.<br><span class="italic-highlight">Ustalmy pierwszy krok.</span></h2>
        
        <div class="contact-details">
          <a href="tel:+48535262302" class="phone">+48 535 262 302 ↗</a>
          <a href="mailto:kontakt@ogrodyrelaks.pl" class="email">kontakt@ogrodyrelaks.pl</a>
          
          <address class="address">
            Rejony pod Warszawą i okolice<br>
            Pniewy • Tarczyn • Grójec i sąsiadujące powiaty
          </address>
        </div>

        <div class="preparation-box">
          <h3>Przygotuj na spotkanie</h3>
          <ul>
            <li>Zdjęcia i przybliżone wymiary działki.</li>
            <li>Listę planowanych prac lub projekt.</li>
            <li>Informacje o wodzie, instalacjach i wjeździe.</li>
          </ul>
        </div>
      </div>

      <!-- PRAWA KOLUMNA: Formularz / Kalendarz -->
      <div class="booking-form-wrapper">
        <p class="form-disclaimer">
          Wybierz dogodny termin w kalendarzu poniżej. Wizja lokalna na Twojej działce z omówieniem zakresu prac i wyceną jest w <strong>100% bezpłatna i niezobowiązująca</strong>.
        </p>
        
        <div class="form-card">
          <div class="card-header">
            <span class="dot"></span>
            <span>Kalendarz spotkań</span>
          </div>

          <form id="booking-form" class="booking-form" action="/api/rezerwacja" method="POST">
            <!-- W nagłówku formularza (np. na mobilkach przycisk też może być) -->
            <div class="form-hero">
              <div class="hero-bar">Zarezerwuj termin</div>
            </div>

            <div class="form-section">
              <h4 class="section-title">Podstawowe informacje</h4>
              
              <div class="input-group">
                <label for="name">Imię i nazwisko *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  placeholder="np. Jan Kowalski" 
                  required 
                  autocomplete="name"
                />
              </div>

              <div class="address-row">
                <div class="input-group">
                  <label for="phone">Numer telefonu *</label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    placeholder="np. 535 262 302" 
                    required 
                    autocomplete="tel"
                  />
                </div>
                <div class="input-group">
                  <label for="email">Adres e-mail * (na ten adres wyślemy potwierdzenie)</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="np. jan.kowalski@gmail.com" 
                    required 
                    autocomplete="email"
                  />
                </div>
              </div>

              <div class="input-group">
                <label for="service">Wybierz usługę *</label>
                <div class="select-wrapper">
                  <select id="service" name="service" required>
                    <option value="wycena" selected>Bezpłatna wycena i konsultacja na działce (0 zł)</option>
                    <option value="projekt">Omówienie projektu i aranżacji</option>
                    <option value="pielegnacja">Pielęgnacja ogrodu / porządkowanie terenu</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="form-section">
              <h4 class="section-title">Termin</h4>
              
              <!-- MOCKUP KALENDARZA (Dynamiczny wybór terminu) -->
              <div class="calendar-widget">
                <div class="calendar-header">
                  <button type="button" class="cal-nav prev disabled" id="cal-prev" aria-label="Poprzedni miesiąc" disabled>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                  </button>
                  <strong id="cal-month-title">{currentMonthName} {currentYear}</strong>
                  <button type="button" class="cal-nav next" id="cal-next" aria-label="Następny miesiąc">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>
                </div>
                <div class="calendar-grid" id="calendar-grid">
                  {dayNamesList.map(name => (
                    <div class="day-name">{name}</div>
                  ))}
                  {Array.from({ length: startOffsetSSR }).map(() => (
                    <div class="day empty" aria-hidden="true"></div>
                  ))}
                  {Array.from({ length: totalDaysInCurrMonth }).map((_, idx) => {
                    const d = idx + 1;
                    const dateObj = new Date(currentYear, currentMonth, d);
                    const dow = dateObj.getDay();
                    const isPast = d < currentDay;
                    const isWeekend = (dow === 0 || dow === 6);
                    const isSelected = (d === defaultSelectedDay);
                    const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                    
                    if (isPast || isWeekend) {
                      return (
                        <div class="day disabled" aria-disabled="true" title={isWeekend ? 'Weekendy są niedostępne' : 'Termin niedostępny'}>
                          {d}
                        </div>
                      );
                    }
                    return (
                      <button
                        type="button"
                        class={`day available ${isSelected ? 'selected' : ''}`}
                        data-date={dateStr}
                        data-day={d}
                        data-month={currentMonth}
                        data-year={currentYear}
                        aria-label={`Wybierz termin ${d} ${monthNames[currentMonth]} ${currentYear}`}
                      >
                        {d}
                      </button>
                    );
                  })}
                </div>

                <!-- Pasek wybranego terminu (natychmiastowy i wyraźny feedback dla klienta) -->
                <div class="selected-date-banner">
                  <div class="banner-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                  <div class="banner-text">
                    <span class="banner-label">Wybrany dzień wizji lokalnej:</span>
                    <strong id="selected-date-text" class="banner-date">{initialSelectedText}</strong>
                  </div>
                </div>

                <p class="calendar-hint">
                  <span class="hint-dot" aria-hidden="true"></span>
                  Kliknij w kalendarzu dowolny dzień roboczy (poniedziałek – piątek), aby zarezerwować bezpłatną konsultację.
                </p>

                <!-- Ukryty input do przechowywania wybranej daty -->
                <input type="hidden" id="selected-date" name="date" value={initialSelectedDateStr} required />
              </div>
            </div>

            <div class="form-section">
              <h4 class="section-title">Dodatkowe informacje</h4>
              
              <div class="input-group">
                <label for="address">Adres *</label>
                <input type="text" id="address" name="address" required />
              </div>
              
              <div class="address-row">
                <div class="input-group">
                  <label for="zip">Kod pocztowy *</label>
                  <input type="text" id="zip" name="zip" required pattern="[0-9]{2}-[0-9]{3}" placeholder="00-000" />
                </div>
                <div class="input-group">
                  <label for="city">Miejscowość *</label>
                  <input type="text" id="city" name="city" required />
                </div>
              </div>
              
              <span class="required-note">* pola wymagane</span>
            </div>

            <div id="booking-feedback" class="booking-feedback" style="display: none;" role="alert"></div>

            <div class="form-footer">
              <div class="footer-meta">
                <div class="price-box">
                  Koszt wyceny: <strong>Darmowa (0 zł)</strong>
                </div>
                <div class="footer-date-info">
                  Termin: <strong id="footer-date-text">{initialFooterDateText}</strong>
                </div>
              </div>
              <button type="submit" class="submit-btn" id="booking-submit-btn">
                <span class="btn-text">Zarezerwuj bezpłatną wycenę &rarr;</span>
                <span class="btn-spinner" id="booking-spinner" style="display: none;"></span>
              </button>
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>
</section>

<!-- Skrypt obsługujący dynamiczny kalendarz i weryfikację e-mail -->
<script>
  function setupBookingCalendar() {
    const monthNames = [
      'Styczeń', 'Luty', 'Marzec', 'Kwiecień', 'Maj', 'Czerwiec',
      'Lipiec', 'Sierpień', 'Wrzesień', 'Październik', 'Listopad', 'Grudzień'
    ];

    const dayNamesPl = [
      'Niedziela', 'Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek', 'Sobota'
    ];

    const monthNamesGenitive = [
      'stycznia', 'lutego', 'marca', 'kwietnia', 'maja', 'czerwca',
      'lipca', 'sierpnia', 'września', 'października', 'listopada', 'grudnia'
    ];

    const formatFullDate = (year: number, month: number, day: number) => {
      const d = new Date(year, month, day);
      const dayName = dayNamesPl[d.getDay()];
      const monthName = monthNamesGenitive[month];
      return `${dayName}, ${day} ${monthName} ${year}`;
    };

    const today = new Date();
    const currentYear = today.getFullYear();
    const currentMonth = today.getMonth(); // 0 - 11
    const currentDay = today.getDate();

    let viewYear = currentYear;
    let viewMonth = currentMonth;

    const prevBtn = document.getElementById('cal-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('cal-next') as HTMLButtonElement | null;
    const monthTitle = document.getElementById('cal-month-title');
    const calendarGrid = document.getElementById('calendar-grid');
    const dateInput = document.getElementById('selected-date') as HTMLInputElement | null;
    const selectedDateText = document.getElementById('selected-date-text');
    const footerDateText = document.getElementById('footer-date-text');
    const form = document.getElementById('booking-form') as HTMLFormElement | null;
    const feedbackEl = document.getElementById('booking-feedback');
    const submitBtn = document.getElementById('booking-submit-btn') as HTMLButtonElement | null;
    const btnSpinner = document.getElementById('booking-spinner');

    if (!calendarGrid || !monthTitle || !prevBtn || !nextBtn || !form) return;

    // Unikamy wielokrotnego bindowania przy View Transitions
    if ((form as any)._bookingBound) return;
    (form as any)._bookingBound = true;

    let selectedDateStr = dateInput?.value || '';
    let occupiedDates: string[] = [];

    // Nie można cofnąć się przed bieżący miesiąc
    const isAtMinMonth = () => {
      return viewYear < currentYear || (viewYear === currentYear && viewMonth <= currentMonth);
    };

    const showFeedback = (msg: string, type: 'success' | 'error') => {
      if (!feedbackEl) return;
      feedbackEl.textContent = msg;
      feedbackEl.className = `booking-feedback is-${type}`;
      feedbackEl.style.display = 'flex';
      feedbackEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    const setSubmitting = (isSubmitting: boolean) => {
      if (!submitBtn) return;
      submitBtn.disabled = isSubmitting;
      const btnText = submitBtn.querySelector('.btn-text');
      if (btnSpinner) btnSpinner.style.display = isSubmitting ? 'inline-block' : 'none';
      if (btnText) btnText.textContent = isSubmitting ? 'Przetwarzanie rezerwacji...' : 'Zarezerwuj bezpłatną wycenę →';
    };

    const attachDayClickListeners = () => {
      calendarGrid.querySelectorAll('button.day.available').forEach(dayBtn => {
        dayBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const chosenDate = dayBtn.getAttribute('data-date');
          const chosenDay = parseInt(dayBtn.getAttribute('data-day') || '1', 10);
          const chosenMonth = parseInt(dayBtn.getAttribute('data-month') || String(viewMonth), 10);
          const chosenYear = parseInt(dayBtn.getAttribute('data-year') || String(viewYear), 10);
          if (!chosenDate) return;

          selectedDateStr = chosenDate;
          if (dateInput) dateInput.value = chosenDate;

          // Natychmiastowa aktualizacja tekstu wybranego terminu
          if (selectedDateText) {
            selectedDateText.textContent = formatFullDate(chosenYear, chosenMonth, chosenDay);
          }
          if (footerDateText) {
            footerDateText.textContent = `${chosenDay} ${monthNamesGenitive[chosenMonth]} ${chosenYear}`;
          }

          // Aktualizacja klasy zaznaczenia na kafelkach
          calendarGrid.querySelectorAll('button.day.available').forEach(d => d.classList.remove('selected'));
          dayBtn.classList.add('selected');
        });
      });
    };

    const renderCalendar = () => {
      // Aktualizacja nagłówka
      monthTitle.textContent = `${monthNames[viewMonth]} ${viewYear}`;

      // Blokada strzałki wstecz jeśli jesteśmy na bieżącym miesiącu
      const isMin = isAtMinMonth();
      prevBtn.disabled = isMin;
      if (isMin) {
        prevBtn.classList.add('disabled');
        prevBtn.setAttribute('aria-disabled', 'true');
      } else {
        prevBtn.classList.remove('disabled');
        prevBtn.removeAttribute('aria-disabled');
      }

      // Nagłówki dni
      const dayNames = ['Pn.', 'Wt.', 'Śr.', 'Cz.', 'Pt.', 'So.', 'Nd.'];
      let html = dayNames.map(name => `<div class="day-name">${name}</div>`).join('');

      // Przesunięcie pierwszego dnia tygodnia (Pn = 0, ..., Nd = 6)
      const firstDay = new Date(viewYear, viewMonth, 1).getDay();
      const startOffset = (firstDay + 6) % 7;

      for (let i = 0; i < startOffset; i++) {
        html += `<div class="day empty" aria-hidden="true"></div>`;
      }

      // Liczba dni w danym miesiącu
      const totalDays = new Date(viewYear, viewMonth + 1, 0).getDate();

      for (let d = 1; d <= totalDays; d++) {
        const thisDate = new Date(viewYear, viewMonth, d);
        const dayOfWeek = thisDate.getDay(); // 0 = Niedziela, 6 = Sobota
        const dateStr = `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;

        // Blokada dni przeszłych
        const isPast = (viewYear < currentYear)
          || (viewYear === currentYear && viewMonth < currentMonth)
          || (viewYear === currentYear && viewMonth === currentMonth && d < currentDay);

        // Wykluczenie sobót i niedziel (dostępne tylko od poniedziałku do piątku)
        const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);

        // Wykluczenie terminów zajętych w Google Calendar
        const isOccupied = occupiedDates.includes(dateStr);

        if (isPast || isWeekend || isOccupied) {
          let reason = 'Termin niedostępny';
          if (isWeekend) reason = 'Weekendy są niedostępne';
          else if (isOccupied) reason = 'Termin zajęty w kalendarzu';

          html += `<div class="day disabled" aria-disabled="true" title="${reason}">${d}</div>`;
        } else {
          const isSelected = (selectedDateStr === dateStr);
          html += `<button type="button" class="day available ${isSelected ? 'selected' : ''}" data-date="${dateStr}" data-day="${d}" data-month="${viewMonth}" data-year="${viewYear}" aria-label="Wybierz termin ${d} ${monthNames[viewMonth]} ${viewYear}">${d}</button>`;
        }
      }

      calendarGrid.innerHTML = html;
      attachDayClickListeners();
    };

    // 1. Asynchroniczne odpytywanie /api/dostepnosc o zajęte terminy z Google Calendar
    const fetchAvailability = async () => {
      try {
        const res = await fetch('/api/dostepnosc');
        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data)) {
            occupiedDates = data;
            renderCalendar();

            // Jeśli wstępnie zaznaczona data okazała się zajęta, resetujemy zaznaczenie
            if (selectedDateStr && occupiedDates.includes(selectedDateStr)) {
              selectedDateStr = '';
              if (dateInput) dateInput.value = '';
              if (selectedDateText) selectedDateText.textContent = 'Wybierz wolny dzień z kalendarza powyżej';
              if (footerDateText) footerDateText.textContent = '—';
            }
          }
        }
      } catch (err) {
        console.warn('[Kalendarz] Błąd pobierania zajętych terminów:', err);
      }
    };

    // Obsługa strzałek zmiany miesięcy
    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (isAtMinMonth()) return;
      viewMonth--;
      if (viewMonth < 0) {
        viewMonth = 11;
        viewYear--;
      }
      renderCalendar();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      viewMonth++;
      if (viewMonth > 11) {
        viewMonth = 0;
        viewYear++;
      }
      renderCalendar();
    });

    // Podpięcie listenerów pod wygenerowane w SSR dni
    attachDayClickListeners();

    // Pobranie aktualnych zajętych terminów z Google Calendar
    fetchAvailability();

    // 2. Obsługa wysyłki formularza rezerwacji przez fetch() z e.preventDefault()
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (feedbackEl) {
        feedbackEl.style.display = 'none';
        feedbackEl.className = 'booking-feedback';
      }

      const nameInput = document.getElementById('name') as HTMLInputElement | null;
      const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
      const emailInput = document.getElementById('email') as HTMLInputElement | null;
      const serviceInput = document.getElementById('service') as HTMLSelectElement | null;
      const addressInput = document.getElementById('address') as HTMLInputElement | null;
      const zipInput = document.getElementById('zip') as HTMLInputElement | null;
      const cityInput = document.getElementById('city') as HTMLInputElement | null;

      const name = nameInput?.value.trim() || '';
      const phone = phoneInput?.value.trim() || '';
      const email = emailInput?.value.trim() || '';
      const service = serviceInput?.value || 'wycena';
      const address = addressInput?.value.trim() || '';
      const zip = zipInput?.value.trim() || '';
      const city = cityInput?.value.trim() || '';
      const date = dateInput?.value.trim() || selectedDateStr;

      // Walidacja frontendowa
      if (!name) {
        showFeedback('Podaj swoje imię i nazwisko.', 'error');
        nameInput?.focus();
        return;
      }

      if (!phone) {
        showFeedback('Podaj numer telefonu do kontaktu.', 'error');
        phoneInput?.focus();
        return;
      }

      if (!email || !emailInput?.validity.valid) {
        showFeedback('Wprowadź poprawny adres e-mail.', 'error');
        emailInput?.focus();
        return;
      }

      if (!date) {
        showFeedback('Wybierz wolny termin z kalendarza powyżej.', 'error');
        return;
      }

      if (occupiedDates.includes(date)) {
        showFeedback('Wybrany termin jest już zajęty. Wybierz inny dzień.', 'error');
        return;
      }

      if (!address || !city) {
        showFeedback('Uzupełnij dokładny adres działki / spotkania.', 'error');
        addressInput?.focus();
        return;
      }

      setSubmitting(true);

      try {
        const response = await fetch('/api/rezerwacja', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            name,
            phone,
            email,
            service,
            address,
            zip,
            city,
            date,
          }),
        });

        let result: any = null;
        try {
          result = await response.json();
        } catch {}

        if (!response.ok || !result?.success) {
          const errMsg =
            result?.error ||
            `Wystąpił błąd podczas wysyłania rezerwacji (status: ${response.status}). Spróbuj ponownie lub zadzwoń.`;
          showFeedback(errMsg, 'error');
          setSubmitting(false);
          return;
        }

        // Komunikat sukcesu wymagany w specyfikacji
        showFeedback('Zarezerwowano! Skontaktujemy się z Tobą w celu potwierdzenia.', 'success');

        // Dodajemy datę do zajętych na widoku i odświeżamy kalendarz
        if (date && !occupiedDates.includes(date)) {
          occupiedDates.push(date);
          selectedDateStr = '';
          if (dateInput) dateInput.value = '';
          renderCalendar();
        }

        // Czyścimy formularz
        form.reset();
        if (selectedDateText) selectedDateText.textContent = 'Wybierz dzień z kalendarza powyżej';
        if (footerDateText) footerDateText.textContent = '—';
      } catch (err) {
        console.error('Błąd wysyłki rezerwacji:', err);
        showFeedback('Nie udało się nawiązać połączenia z serwerem. Sprawdź połączenie i spróbuj ponownie.', 'error');
      } finally {
        setSubmitting(false);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBookingCalendar);
  } else {
    setupBookingCalendar();
  }
  document.addEventListener('astro:page-load', setupBookingCalendar);
</script>

<style>
  /* Zmienne i ogólny układ */
  .booking-section {
    padding: 100px 0;
