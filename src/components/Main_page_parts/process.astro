---
import { Image } from 'astro:assets';

// TUTAJ ZIMPORTUJ SWOJE LOKALNE ZDJĘCIA
// import step1Img from '../assets/images/step1.jpg';
// import step3Img from '../assets/images/step3.jpg';
// import step4Img from '../assets/images/step4.png';

// Na potrzeby dema używam zewnętrznych URL, ale Ty podmień je na swoje importy
const step1Img = "https://images.unsplash.com/photo-1558904541-efa843a96f0f?q=80&w=600&auto=format&fit=crop";
const step3Img = "https://images.unsplash.com/photo-1605810730434-7631ac76ec81?q=80&w=600&auto=format&fit=crop";
const step4Img = "https://images.unsplash.com/photo-1584622650111-993a426fbf0a?q=80&w=600&auto=format&fit=crop"; 
// Uwaga: Zamiast step4Img (zdjęcia ogrodu), docelowo wstaw tam przezroczystego PNG z grafiką checklisty z projektu.
---

<section class="process-section">
  <div class="container">
    
    <!-- NAGŁÓWEK -->
    <div class="process-header">
      <div class="header-left">
        <span class="kicker"><span class="dot"></span> NASZ PROCES</span>
        <h2>Jak działamy,<br><span class="italic-text">od A do Z</span></h2>
      </div>
      
      <div class="header-right">
        <p>Zapewniamy profesjonalne usługi ogrodnicze z wieloletnim doświadczeniem i naciskiem na najwyższą jakość.</p>
        <button class="scroll-down-btn" aria-label="Przewiń w dół">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- GRID BENTO BOX -->
    <div class="process-grid">
      
      <!-- KARTA 1 (Wysoka, lewa strona) -->
      <div class="card card-1">
        <div class="card-content">
          <span class="step-num">Krok 01</span>
          <h3>Bezpłatna wycena ogrodu</h3>
          <p>Zapewniamy profesjonalne usługi ogrodnicze z wieloletnim doświadczeniem i naciskiem na najwyższą jakość.</p>
        </div>
        <div class="card-image-tall">
          <Image src={step1Img} alt="Pracownicy oceniający trawnik" width={400} height={500} class="img-cover" />
        </div>
      </div>

      <!-- KARTA 2 (Górny środek, tylko ilustracja) -->
      <div class="card card-2">
        <div class="card-content">
          <span class="step-num">Krok 02</span>
          <h3>Śledź harmonogram prac</h3>
          <p>Bądź na bieżąco z każdą naszą wizytą dzięki stałym informacjom o postępach.</p>
        </div>
        <div class="card-graphic-center">
          <!-- Zastąp to docelową grafiką/ikoną SVG z projektu -->
          <div class="mock-graphic">
             <span class="icon-circle">⚙️</span>
          </div>
        </div>
      </div>

      <!-- KARTA 3 (Górna prawa, zdjęcie na dole) -->
      <div class="card card-3">
        <div class="card-content">
          <span class="step-num">Krok 03</span>
          <h3>Indywidualny plan i realizacja</h3>
          <p>Dopasowany projekt i przejrzysty kosztorys zbudowany specjalnie dla Twojego ogrodu.</p>
        </div>
        <div class="card-image-short">
          <Image src={step3Img} alt="Piękny dom z ogrodem" width={400} height={300} class="img-cover" />
        </div>
      </div>

      <!-- KARTA 4 (Zielona, szeroka, dół prawy) -->
      <div class="card card-4 dark-theme">
        <div class="card-4-content">
          <span class="step-num step-num-dark">Krok 04</span>
          <span class="badge">Gwarancja Satysfakcji</span>
          <h3>Zostajemy, dopóki nie będzie idealnie</h3>
          <p>Każde zlecenie objęte jest naszą gwarancją poprawy — ewentualne usterki usuwamy bezpłatnie.</p>
          <a href="/kontakt" class="btn-primary">Zamów wizytę ↗</a>
        </div>
        <div class="card-4-image">
          <!-- Tutaj wstaw grafikę "Completion Checklist" wyciętą bez tła (PNG/WebP) -->
          <Image src={step4Img} alt="Checklista zakończenia prac" width={500} height={400} class="img-contain" />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Zmienne i reset sekcji */
  .process-section {
    padding: 100px 0;
    background-color: #fafaf9; /* Jasne tło z projektu */
    font-family: 'Inter', sans-serif; /* Zakładam bezszeryfowy font jak w projekcie */
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* --- NAGŁÓWEK --- */
  .process-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
    gap: 40px;
  }

  .header-left {
    max-width: 600px;
  }

  .kicker {
    font-size: 0.85rem;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: #3b5a38; /* Ciemna zieleń */
    border-radius: 50%;
    display: inline-block;
  }

  .header-left h2 {
    font-size: 3.5rem;
    line-height: 1.1;
    color: #1a1a1a;
    margin: 0;
  }

  .italic-text {
    font-family: 'Playfair Display', serif; /* Podmień na swój szeryfowy font */
    font-style: italic;
    font-weight: 400;
  }

  .header-right {
    max-width: 350px;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
  }

  .header-right p {
    color: #6b7280;
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  .scroll-down-btn {
    width: 48px;
    height: 48px;
    background-color: #2d4a22; /* Ciemnozielony */
    color: white;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .scroll-down-btn:hover {
    transform: translateY(4px);
  }

  /* --- BENTO BOX GRID --- */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(320px, auto);
    gap: 24px;
  }

  /* Rozkład kart na komputerze */
  .card-1 { grid-column: 1 / 2; grid-row: 1 / 3; }
  .card-2 { grid-column: 2 / 3; grid-row: 1 / 2; }
  .card-3 { grid-column: 3 / 4; grid-row: 1 / 2; }
  .card-4 { grid-column: 2 / 4; grid-row: 2 / 3; }

  /* --- WSPÓLNE STYLE KART --- */
  .card {
    background-color: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    position: relative;
  }

  .card-content {
    padding: 40px;
    flex-shrink: 0;
  }

  .step-num {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 12px;
  }

  .card h3 {
    font-size: 1.5rem;
    color: #1a1a1a;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .card p {
    font-size: 0.95rem;
    color: #6b7280;
    margin: 0;
    line-height: 1.6;
  }

  /* Specyficzne style zdjęć w kartach */
  .card-image-tall {
    flex-grow: 1;
    min-height: 250px;
    padding: 0 20px 20px 20px;
  }

  .card-image-tall img {
    border-radius: 16px;
  }

  .card-image-short {
    flex-grow: 1;
    min-height: 180px;
    padding: 0 20px 20px 20px;
  }

  .card-image-short img {
    border-radius: 16px;
  }

  .img-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-graphic-center {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .mock-graphic {
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(134,185,66,0.2) 0%, rgba(255,255,255,0) 70%);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  .icon-circle { font-size: 2rem; }

  /* --- KARTA 4 (Zielona z formularzem/checklistą) --- */
  .dark-theme {
    background: linear-gradient(135deg, #446840 0%, #2d4a22 100%);
    color: white;
    flex-direction: row; /* Tekst po lewej, obraz po prawej na PC */
    align-items: center;
  }

  .card-4-content {
    padding: 40px;
    flex: 1;
    max-width: 50%;
  }

  .step-num-dark {
    color: rgba(255, 255, 255, 0.8);
  }

  .badge {
    background-color: rgba(0, 0, 0, 0.2);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-left: 12px;
    vertical-align: middle;
  }

  .dark-theme h3 {
    color: white;
    font-size: 2rem;
    margin-top: 16px;
  }

  .dark-theme p {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 24px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #86b942;
    color: #1a1a1a;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 30px;
    font-weight: 700;
    transition: background-color 0.3s ease;
  }

  .btn-primary:hover {
    background-color: #97cc4e;
  }

  .card-4-image {
    flex: 1;
    height: 100%;
    position: relative;
    min-height: 300px;
  }

  .img-contain {
    width: 100%;
    height: 100%;
    object-fit: contain; /* Używamy contain, aby grafika checklisty z PNG nie została ucięta */
    object-position: center right;
  }

  /* --- RESPONSYWNOŚĆ (Mobile i Tablet) --- */
  @media (max-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr); /* 2 kolumny na średnich ekranach */
    }
    .card-1 { grid-column: 1 / 2; grid-row: 1 / 2; }
    .card-2 { grid-column: 2 / 3; grid-row: 1 / 2; }
    .card-3 { grid-column: 1 / 2; grid-row: 2 / 3; }
    .card-4 { grid-column: 1 / 3; grid-row: 3 / 4; }
  }

  @media (max-width: 768px) {
    .process-section {
      padding: 60px 0;
    }

    .process-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      text-align: left;
    }

    .header-left h2 {
      font-size: 2.5rem;
    }

    .header-right {
      max-width: 100%;
      align-items: flex-start;
      text-align: left;
    }

    .scroll-down-btn {
      display: none; /* W projekcie mobile strzałka znika */
    }

    .process-grid {
      grid-template-columns: 1fr; /* 1 kolumna na telefony */
      gap: 16px;
    }

    /* Resetowanie spanów siatki dla mobile */
    .card-1, .card-2, .card-3, .card-4 {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .dark-theme {
      flex-direction: column; /* Tekst nad obrazkiem na mobile */
    }

    .card-4-content {
      max-width: 100%;
      padding-bottom: 20px;
    }

    .card-4-image {
      width: 100%;
      min-height: 250px;
    }
    
    .img-contain {
      object-position: center bottom;
    }
  }
</style>