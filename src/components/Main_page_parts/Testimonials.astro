                </svg>
              </div>
            </div>
            
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 100px 0;
    background-color: #ffffff; /* Zgodnie ze screenem tło główne jest białe/bardzo jasne */
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* --- NAGŁÓWEK --- */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
    gap: 40px;
  }

  .header-left {
    max-width: 500px;
  }

  .kicker {
    font-size: 0.85rem;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: #3b5a38; 
    border-radius: 50%;
    display: inline-block;
  }

  .header-left h2 {
    font-size: 3.5rem;
    line-height: 1.1;
    color: #1a1a1a;
    margin: 0;
  }

  .italic-text {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
  }

  .header-right {
    max-width: 400px;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 24px;
  }

  .header-right p {
    color: #6b7280;
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Guziki (strzałki ze screena) */
  .arrows-container {
    display: flex;
    gap: 12px;
  }

  .arrow-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid #e5e7eb;
  }

  .arrow-prev {
    background-color: #ffffff;
    color: #1a1a1a;
  }
  .arrow-prev:hover {
    background-color: #f3f4f6;
  }

  .arrow-next {
    background-color: #1f3318; /* Ciemna zieleń z projektu */
    color: #ffffff;
    border-color: #1f3318;
  }
  .arrow-next:hover {
    background-color: #2d4a22;
  }

  /* --- SLIDER WAGONIKI --- */
  .slider-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 20px 0 40px 0;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }

  .slider-wrapper.is-dragging {
    cursor: grabbing;
  }

  .slider-wrapper.is-dragging .review-card {
    pointer-events: none;
  }

  .slider-inner {
    display: flex;
    gap: 24px;
    width: max-content;
    will-change: transform;
  }

  .slider-track {
    display: flex;
    gap: 24px;
    flex-shrink: 0;
    width: max-content;
  }

  /* --- KARTY OPINII --- */
  .review-card {
    width: 380px;
    flex: 0 0 380px;
    background-color: #ffffff;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.02);
    border: 1px solid #f3f4f6;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 320px;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(0,0,0,0.07);
  }

  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
    user-drag: none;
  }

  .author-text {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 700;
    color: #1a1a1a;
    font-size: 1.05rem;
  }

  .author-role {
    font-size: 0.85rem;
    color: #6b7280;
  }

  .rating-number {
    font-size: 2.2rem;
    font-weight: 400;
    color: #1a1a1a;
    line-height: 1;
    letter-spacing: -1px;
  }

  /* ŚRODEK KARTY (Cytat i Tekst) */
  .card-middle {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .quote-icon {
    margin-bottom: 12px;
  }

  .review-text {
    font-size: 1.05rem;
    color: #374151;
    line-height: 1.6;
    margin: 0;
  }

  /* DÓŁ KARTY (Google + Gwiazdki) */
  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
    padding-top: 24px;
    /* border-top: 1px solid #f3f4f6; Opcjonalnie, w projekcie go chyba nie ma */
  }

  .stars-container {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  
  .verified-icon {
    margin-left: 4px;
  }

  /* --- RESPONSYWNOŚĆ --- */
  @media (max-width: 768px) {
    .testimonials-section {
      padding: 60px 0;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      text-align: left;
    }

    .header-left h2 {
      font-size: 2.5rem;
    }

    .header-right {
      max-width: 100%;
      align-items: flex-start;
      text-align: left;
    }

    .arrows-container {
      margin-top: 10px;
    }

    .review-card {
      width: 320px;
      flex: 0 0 320px;
      padding: 24px;
    }
  }
</style>

<script>
  function initTestimonialsSlider() {
    const sliderWrapper = document.getElementById('testimonialsSlider');
    const sliderInner = document.getElementById('testimonialsInner');
    if (!sliderWrapper || !sliderInner) return;

    // Unikamy podwójnej inicjalizacji przy Astro page transitions
    if ((sliderWrapper as any)._sliderInitialized) return;
    (sliderWrapper as any)._sliderInitialized = true;

    const tracks = sliderInner.querySelectorAll('.slider-track');
    if (tracks.length < 2) return;

    const track1 = tracks[0] as HTMLElement;
    const track2 = tracks[1] as HTMLElement;

    let singleTrackWidth = 0;
    function updateTrackWidth() {
      const r1 = track1.getBoundingClientRect();
      const r2 = track2.getBoundingClientRect();
      const dist = r2.left - r1.left;
      if (dist > 0) {
        singleTrackWidth = dist;
      }
    }
    updateTrackWidth();

    window.addEventListener('resize', updateTrackWidth);
    window.addEventListener('load', updateTrackWidth);
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => updateTrackWidth());
      ro.observe(sliderInner);
    }

    let currentX = 0;
    let isDragging = false;
    let isWheeling = false;
    let isCardHovered = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragStartCurrentX = 0;
    let lastDragX = 0;
    let lastDragTime = performance.now();
    let dragVelocity = 0;
    let inertiaVelocity = 0;
    let isHorizontalDrag: boolean | null = null;
    let wheelTimeout: any = null;

    // Prędkość domyślna: pełny obieg w 40s (zgodnie z oryginalną animacją scroll-reviews)
    const BASE_LOOP_SECONDS = 40;

    // Wykrywanie hover tylko dla precyzyjnego wskaźnika (mysz komputerowa, nie telefon)
    const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (isFinePointer) {
      // Zatrzymujemy auto-przesuwanie tylko wtedy, gdy kursor najeżdża bezpośrednio na konkretną kartę
      const cards = sliderInner.querySelectorAll('.review-card');
      cards.forEach((card) => {
        card.addEventListener('mouseenter', () => {
          isCardHovered = true;
        });
        card.addEventListener('mouseleave', () => {
          isCardHovered = false;
        });
      });
    }

    function normalizeCurrentX() {
      if (singleTrackWidth <= 0) return;
      while (currentX > 0) currentX -= singleTrackWidth;
      while (currentX <= -singleTrackWidth) currentX += singleTrackWidth;
    }

    function applyTransform() {
      sliderInner.style.transform = `translate3d(${currentX}px, 0, 0)`;
    }

    // 1. OBSŁUGA DOTYKU NA TELEFONIE (SWIPE / DRAG PALCEM LEWO-PRAWO)
    sliderWrapper.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length !== 1) return;
      isDragging = true;
      isHorizontalDrag = null;
      dragStartX = e.touches[0].clientX;
      dragStartY = e.touches[0].clientY;
      dragStartCurrentX = currentX;
      lastDragX = dragStartX;
      lastDragTime = performance.now();
      dragVelocity = 0;
      inertiaVelocity = 0;
    }, { passive: true });

    sliderWrapper.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isDragging || e.touches.length !== 1) return;
      const clientX = e.touches[0].clientX;
      const clientY = e.touches[0].clientY;
      const dx = clientX - dragStartX;
      const dy = clientY - dragStartY;

      // Rozpoznajemy intencję: scroll pionowy strony vs przesunięcie poziome wagoników
      if (isHorizontalDrag === null) {
        if (Math.hypot(dx, dy) > 7) {
          isHorizontalDrag = Math.abs(dx) >= Math.abs(dy);
          if (!isHorizontalDrag) {
            isDragging = false;
            return;
          }
        } else {
          return;
        }
      }

      if (isHorizontalDrag) {
        // Blokujemy pionowy scroll strony, gdy użytkownik przesuwa wagoniki poziomo
        if (e.cancelable) e.preventDefault();

        const now = performance.now();
        const dt = now - lastDragTime;
        if (dt > 10) {
          dragVelocity = (clientX - lastDragX) / (dt / 1000);
          lastDragX = clientX;
          lastDragTime = now;
        }

        currentX = dragStartCurrentX + dx;
        normalizeCurrentX();
        applyTransform();
      }
    }, { passive: false });

    function handleTouchEnd() {
      if (!isDragging) return;
      isDragging = false;
      if (isHorizontalDrag) {
        if (Math.abs(dragVelocity) > 60) {
          inertiaVelocity = dragVelocity;
        } else {
          inertiaVelocity = 0;
        }
      }
      isHorizontalDrag = null;
    }

    sliderWrapper.addEventListener('touchend', handleTouchEnd);
    sliderWrapper.addEventListener('touchcancel', handleTouchEnd);

    // 2. PRZECIĄGANIE MYSZKĄ NA KOMPUTERZE
    sliderWrapper.addEventListener('mousedown', (e: MouseEvent) => {
      if (e.button !== 0) return;
      isDragging = true;
      isHorizontalDrag = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragStartCurrentX = currentX;
      lastDragX = dragStartX;
      lastDragTime = performance.now();
      dragVelocity = 0;
      inertiaVelocity = 0;
      sliderWrapper.classList.add('is-dragging');
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDragging) return;
      const dx = e.clientX - dragStartX;

      const now = performance.now();
      const dt = now - lastDragTime;
      if (dt > 10) {
        dragVelocity = (e.clientX - lastDragX) / (dt / 1000);
        lastDragX = e.clientX;
        lastDragTime = now;
      }

      currentX = dragStartCurrentX + dx;
      normalizeCurrentX();
      applyTransform();
    });

    window.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      sliderWrapper.classList.remove('is-dragging');
      if (Math.abs(dragVelocity) > 60) {
        inertiaVelocity = dragVelocity;
      } else {
        inertiaVelocity = 0;
      }
    });

    // 3. OBSŁUGA NA KOMPUTERZE: SHIFT + SCROLL KÓŁKIEM MYSZKI
    sliderWrapper.addEventListener('wheel', (e: WheelEvent) => {
      // Reagujemy, gdy wciśnięty jest Shift LUB gdy kółko/trackpad przekazuje scroll poziomy deltaX
      if (e.shiftKey || Math.abs(e.deltaX) > 0) {
        e.preventDefault();

        // Kółko pionowe z Shiftem może być przekazywane jako deltaY lub deltaX w zależności od systemu
        const delta = Math.abs(e.deltaX) > 0 ? e.deltaX : e.deltaY;

        // Przesuwamy wagoniki zgodnie z ruchem kółka
        currentX -= delta * 1.15;
        normalizeCurrentX();
        applyTransform();

        // Podczas aktywnego scrollowania wstrzymujemy automatyczny ruch
        isWheeling = true;
        clearTimeout(wheelTimeout);
        wheelTimeout = setTimeout(() => {
          isWheeling = false;
        }, 400);
      }
    }, { passive: false });

    // 4. GŁÓWNA PĘTLA ANIMACJI (REQUEST ANIMATION FRAME)
    let lastFrameTime = performance.now();

    function animate(now: number) {
      const dt = Math.min((now - lastFrameTime) / 1000, 0.1);
      lastFrameTime = now;

      if (!isDragging && !isWheeling) {
        // Płynna inercja po dynamicznym puszczeniu palca
        if (Math.abs(inertiaVelocity) > 20) {
          currentX += inertiaVelocity * dt;
          inertiaVelocity *= Math.pow(0.08, dt); // Płynne tłumienie
          normalizeCurrentX();
          applyTransform();
        } else {
          inertiaVelocity = 0;
          // Automatyczny ruch wagoników, gdy użytkownik nie wchodzi w interakcję
          if (!isCardHovered) {
            const speed = singleTrackWidth > 0 ? singleTrackWidth / BASE_LOOP_SECONDS : 45;
            currentX -= speed * dt;
            normalizeCurrentX();
            applyTransform();
          }
        }
      }

      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
  }

  // Uruchomienie przy załadowaniu strony oraz przy przejściach Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTestimonialsSlider);
  } else {
    initTestimonialsSlider();
  }
  document.addEventListener('astro:page-load', initTestimonialsSlider);
</script>