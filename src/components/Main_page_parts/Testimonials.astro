---
import { Image } from 'astro:assets';

// TUTAJ WKLEJ LINK DO SWOJEJ WIZYTÓWKI GOOGLE MAPS
const googleMapsUrl = "https://g.page/r/TWÓJ_LINK_DO_OPINII/review";

// TUTAJ MOŻESZ WKLEIĆ PRAWDZIWE OPINIE SKOPIOWANE Z GOOGLE
const googleReviews = [
  {
    name: "Michał D.",
    role: "Właściciel firmy",
    avatar: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=150&auto=format&fit=crop",
    rating: "5.0",
    text: "Nasz trawnik przed firmą zawsze był traktowany po macoszemu przez poprzednie ekipy. Nowa firma dba o niego jak o własny — zieleń wygląda perfekcyjnie przez cały rok."
  },
  {
    name: "Karolina L.",
    role: "Klient indywidualny",
    avatar: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?q=80&w=150&auto=format&fit=crop",
    rating: "5.0",
    text: "Świetna komunikacja i uczciwe ceny. Jedyny powód, dla którego to nie jest pełne 5+, to małe przesunięcie terminu w bardzo zajętym tygodniu wiosennym — ale uprzedzili nas o tym z wyprzedzeniem."
  },
  {
    name: "Dariusz P.",
    role: "Zarządca obiektu",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=150&auto=format&fit=crop",
    rating: "5.0",
    text: "Zajmują się naszym komercyjnym placem przez całą zimę. Konsekwentne odśnieżanie za każdym razem, co naprawdę ma ogromne znaczenie, dopóki tego nie zabraknie."
  },
  {
    name: "Anna W.",
    role: "Właścicielka domu",
    avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=150&auto=format&fit=crop",
    rating: "5.0",
    text: "Trawnik nigdy nie wyglądał tak zdrowo i gęsto. Profesjonalne doradztwo w zakresie nawożenia i nawadniania to strzał w dziesiątkę. Polecam każdemu z czystym sumieniem."
  }
];
---

<section class="testimonials-section">
  <div class="container">
    
    <!-- NAGŁÓWEK -->
    <div class="section-header">
      <div class="header-left">
        <span class="kicker"><span class="dot"></span> OPINIE KLIENTÓW</span>
        <h2>Co mówią o nas<br><span class="italic-text">nasi klienci</span></h2>
      </div>
      
      <div class="header-right">
        <p>Dbamy o cały cykl sezonowy — bez konieczności żonglowania wieloma wykonawcami.</p>
        
        <!-- Strzałki z projektu - tutaj mogą pełnić rolę linku do Google Maps -->
        <div class="arrows-container">
          <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="arrow-btn arrow-prev" aria-label="Zobacz na Google">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </a>
          <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="arrow-btn arrow-next" aria-label="Napisz opinię na Google">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- SLIDER (WAGONIKI) -->
  <div class="slider-wrapper">
    <!-- Wagonik 1 -->
    <div class="slider-track">
      {googleReviews.map((review) => (
        <div class="review-card">
          
          <div class="card-top">
            <div class="author-info">
              <img src={review.avatar} alt={review.name} class="avatar" loading="lazy" />
              <div class="author-text">
                <span class="author-name">{review.name}</span>
                <span class="author-role">{review.role}</span>
              </div>
            </div>
            <div class="rating-number">{review.rating}</div>
          </div>

          <div class="card-middle">
            <!-- Ikona cudzysłowu -->
            <svg class="quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="#e5e7eb" xmlns="http://www.w3.org/2000/svg">
              <path d="M14.017 18L14.017 10.609C14.017 4.905 17.748 1.039 23 0L23.995 2.151C21.563 3.068 20 5.789 20 8H24V18H14.017ZM0 18V10.609C0 4.905 3.748 1.038 9 0L9.996 2.151C7.563 3.068 6 5.789 6 8H9.983L9.983 18L0 18Z"/>
            </svg>
            <p class="review-text">{review.text}</p>
          </div>

          <div class="card-bottom">
            <!-- Logo Google (G) -->
            <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>

            <!-- Gwiazdki -->
            <div class="stars-container">
              {[1, 2, 3, 4, 5].map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#F59E0B" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                </svg>
              ))}
              <!-- Ikonka zweryfikowane -->
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="verified-icon">
                <circle cx="12" cy="12" r="10" fill="#3B82F6"/>
                <path d="M8 12L11 15L16 9" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          
        </div>
      ))}
    </div>

    <!-- Wagonik 2 (Klon do nieskończonej pętli) -->
    <div class="slider-track" aria-hidden="true">
      {googleReviews.map((review) => (
        <div class="review-card">
          
          <div class="card-top">
            <div class="author-info">
              <img src={review.avatar} alt={review.name} class="avatar" loading="lazy" />
              <div class="author-text">
                <span class="author-name">{review.name}</span>
                <span class="author-role">{review.role}</span>
              </div>
            </div>
            <div class="rating-number">{review.rating}</div>
          </div>

          <div class="card-middle">
            <svg class="quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="#e5e7eb" xmlns="http://www.w3.org/2000/svg">
              <path d="M14.017 18L14.017 10.609C14.017 4.905 17.748 1.039 23 0L23.995 2.151C21.563 3.068 20 5.789 20 8H24V18H14.017ZM0 18V10.609C0 4.905 3.748 1.038 9 0L9.996 2.151C7.563 3.068 6 5.789 6 8H9.983L9.983 18L0 18Z"/>
            </svg>
            <p class="review-text">{review.text}</p>
          </div>

          <div class="card-bottom">
            <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>

            <div class="stars-container">
              {[1, 2, 3, 4, 5].map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#F59E0B" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                </svg>
              ))}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="verified-icon">
                <circle cx="12" cy="12" r="10" fill="#3B82F6"/>
                <path d="M8 12L11 15L16 9" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 100px 0;
    background-color: #ffffff; /* Zgodnie ze screenem tło główne jest białe/bardzo jasne */
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* --- NAGŁÓWEK --- */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
    gap: 40px;
  }

  .header-left {
    max-width: 500px;
  }

  .kicker {
    font-size: 0.85rem;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: #3b5a38; 
    border-radius: 50%;
    display: inline-block;
  }

  .header-left h2 {
    font-size: 3.5rem;
    line-height: 1.1;
    color: #1a1a1a;
    margin: 0;
  }

  .italic-text {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
  }

  .header-right {
    max-width: 400px;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 24px;
  }

  .header-right p {
    color: #6b7280;
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Guziki (strzałki ze screena) */
  .arrows-container {
    display: flex;
    gap: 12px;
  }

  .arrow-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid #e5e7eb;
  }

  .arrow-prev {
    background-color: #ffffff;
    color: #1a1a1a;
  }
  .arrow-prev:hover {
    background-color: #f3f4f6;
  }

  .arrow-next {
    background-color: #1f3318; /* Ciemna zieleń z projektu */
    color: #ffffff;
    border-color: #1f3318;
  }
  .arrow-next:hover {
    background-color: #2d4a22;
  }

  /* --- SLIDER WAGONIKI --- */
  .slider-wrapper {
    display: flex;
    gap: 24px;
    width: 100%;
    overflow: hidden;
    padding: 20px 0 40px 0;
  }

  .slider-track {
    display: flex;
    gap: 24px;
    flex-shrink: 0;
    width: max-content; 
    animation: scroll-reviews 40s linear infinite; /* Animacja przewijania */
    will-change: transform;
  }

  .slider-wrapper:hover .slider-track {
    animation-play-state: paused;
  }

  @keyframes scroll-reviews {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-100% - 24px)); }
  }

  /* --- KARTY OPINII --- */
  .review-card {
    width: 380px;
    flex: 0 0 380px;
    background-color: #ffffff;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.02);
    border: 1px solid #f3f4f6;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 320px;
  }

  /* GÓRA KARTY (Awatar + Ocena) */
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-text {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 700;
    color: #1a1a1a;
    font-size: 1.05rem;
  }

  .author-role {
    font-size: 0.85rem;
    color: #6b7280;
  }

  .rating-number {
    font-size: 2.2rem;
    font-weight: 400;
    color: #1a1a1a;
    line-height: 1;
    letter-spacing: -1px;
  }

  /* ŚRODEK KARTY (Cytat i Tekst) */
  .card-middle {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .quote-icon {
    margin-bottom: 12px;
  }

  .review-text {
    font-size: 1.05rem;
    color: #374151;
    line-height: 1.6;
    margin: 0;
  }

  /* DÓŁ KARTY (Google + Gwiazdki) */
  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
    padding-top: 24px;
    /* border-top: 1px solid #f3f4f6; Opcjonalnie, w projekcie go chyba nie ma */
  }

  .stars-container {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  
  .verified-icon {
    margin-left: 4px;
  }

  /* --- RESPONSYWNOŚĆ --- */
  @media (max-width: 768px) {
    .testimonials-section {
      padding: 60px 0;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      text-align: left;
    }

    .header-left h2 {
      font-size: 2.5rem;
    }

    .header-right {
      max-width: 100%;
      align-items: flex-start;
      text-align: left;
    }

    .arrows-container {
      margin-top: 10px;
    }

    .review-card {
      width: 320px;
      flex: 0 0 320px;
      padding: 24px;
    }
  }
</style>