<script>
  // 1. INICJALIZACJA KARUZELI (WAGONIKI)
  function initTestimonialsSlider() {
    const sliderWrapper = document.getElementById('testimonialsSlider');
    const sliderInner = document.getElementById('testimonialsInner');
    if (!sliderWrapper || !sliderInner) return;

    // Unikamy podwójnej inicjalizacji przy Astro page transitions
    if ((sliderWrapper as any)._sliderInitialized) return;
    (sliderWrapper as any)._sliderInitialized = true;

    const tracks = sliderInner.querySelectorAll('.slider-track');
    if (tracks.length < 2) return;

    const track1 = tracks[0] as HTMLElement;
    const track2 = tracks[1] as HTMLElement;

    let singleTrackWidth = 0;
    function updateTrackWidth() {
      const r1 = track1.getBoundingClientRect();
      const r2 = track2.getBoundingClientRect();
      const dist = r2.left - r1.left;
      if (dist > 0) {
        singleTrackWidth = dist;
      }
    }
    updateTrackWidth();

    window.addEventListener('resize', updateTrackWidth);
    window.addEventListener('load', updateTrackWidth);
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => updateTrackWidth());
      ro.observe(sliderInner);
    }

    let currentX = 0;
    let isDragging = false;
    let isWheeling = false;
    let isCardHovered = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragStartCurrentX = 0;
    let lastDragX = 0;
    let lastDragTime = performance.now();
    let dragVelocity = 0;
    let inertiaVelocity = 0;
    let isHorizontalDrag: boolean | null = null;
    let wheelTimeout: any = null;

    // Prędkość domyślna: pełny obieg w 40s
    const BASE_LOOP_SECONDS = 40;

    // Wykrywanie hover tylko dla precyzyjnego wskaźnika (mysz)
    const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (isFinePointer) {
      const cards = sliderInner.querySelectorAll('.review-card');
      cards.forEach((card) => {
        card.addEventListener('mouseenter', () => {
          isCardHovered = true;
        });
        card.addEventListener('mouseleave', () => {
          isCardHovered = false;
        });
      });
    }

    function normalizeCurrentX() {
      if (singleTrackWidth <= 0) return;
      while (currentX > 0) currentX -= singleTrackWidth;
      while (currentX <= -singleTrackWidth) currentX += singleTrackWidth;
    }

    function applyTransform() {
      sliderInner.style.transform = `translate3d(${currentX}px, 0, 0)`;
    }

    // Touch na urządzeniach mobilnych
    sliderWrapper.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length !== 1) return;
      isDragging = true;
      isHorizontalDrag = null;
      dragStartX = e.touches[0].clientX;
      dragStartY = e.touches[0].clientY;
      dragStartCurrentX = currentX;
      lastDragX = dragStartX;
      lastDragTime = performance.now();
      dragVelocity = 0;
      inertiaVelocity = 0;
    }, { passive: true });

    sliderWrapper.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isDragging || e.touches.length !== 1) return;
      const clientX = e.touches[0].clientX;
      const clientY = e.touches[0].clientY;
      const dx = clientX - dragStartX;
      const dy = clientY - dragStartY;

      if (isHorizontalDrag === null) {
        if (Math.hypot(dx, dy) > 7) {
          isHorizontalDrag = Math.abs(dx) >= Math.abs(dy);
          if (!isHorizontalDrag) {
            isDragging = false;
            return;
          }
        } else {
          return;
        }
      }

      if (isHorizontalDrag) {
        if (e.cancelable) e.preventDefault();

        const now = performance.now();
        const dt = now - lastDragTime;
        if (dt > 10) {
          dragVelocity = (clientX - lastDragX) / (dt / 1000);
          lastDragX = clientX;
          lastDragTime = now;
        }

        currentX = dragStartCurrentX + dx;
        normalizeCurrentX();
        applyTransform();
      }
    }, { passive: false });

    function handleTouchEnd() {
      if (!isDragging) return;
      isDragging = false;
      if (isHorizontalDrag) {
        if (Math.abs(dragVelocity) > 60) {
          inertiaVelocity = dragVelocity;
        } else {
          inertiaVelocity = 0;
        }
      }
      isHorizontalDrag = null;
    }

    sliderWrapper.addEventListener('touchend', handleTouchEnd);
    sliderWrapper.addEventListener('touchcancel', handleTouchEnd);

    // Przeciąganie myszką na komputerze
    sliderWrapper.addEventListener('mousedown', (e: MouseEvent) => {
      if (e.button !== 0) return;
      isDragging = true;
      isHorizontalDrag = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragStartCurrentX = currentX;
      lastDragX = dragStartX;
      lastDragTime = performance.now();
      dragVelocity = 0;
      inertiaVelocity = 0;
      sliderWrapper.classList.add('is-dragging');
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDragging) return;
      const dx = e.clientX - dragStartX;

      const now = performance.now();
      const dt = now - lastDragTime;
      if (dt > 10) {
        dragVelocity = (e.clientX - lastDragX) / (dt / 1000);
        lastDragX = e.clientX;
        lastDragTime = now;
      }

      currentX = dragStartCurrentX + dx;
      normalizeCurrentX();
      applyTransform();
    });

    window.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      sliderWrapper.classList.remove('is-dragging');
      if (Math.abs(dragVelocity) > 60) {
        inertiaVelocity = dragVelocity;
      } else {
        inertiaVelocity = 0;
      }
    });

    // Kółko myszy ze shiftem
    sliderWrapper.addEventListener('wheel', (e: WheelEvent) => {
      if (e.shiftKey || Math.abs(e.deltaX) > 0) {
        e.preventDefault();
        const delta = Math.abs(e.deltaX) > 0 ? e.deltaX : e.deltaY;
        currentX -= delta * 1.15;
        normalizeCurrentX();
        applyTransform();

        isWheeling = true;
        clearTimeout(wheelTimeout);
        wheelTimeout = setTimeout(() => {
          isWheeling = false;
        }, 400);
      }
    }, { passive: false });

    // Główna pętla RAF
    let lastFrameTime = performance.now();
    function animate(now: number) {
      const dt = Math.min((now - lastFrameTime) / 1000, 0.1);
      lastFrameTime = now;

      if (!isDragging && !isWheeling) {
        if (Math.abs(inertiaVelocity) > 20) {
          currentX += inertiaVelocity * dt;
          inertiaVelocity *= Math.pow(0.08, dt);
          normalizeCurrentX();
          applyTransform();
        } else {
          inertiaVelocity = 0;
          if (!isCardHovered) {
            const speed = singleTrackWidth > 0 ? singleTrackWidth / BASE_LOOP_SECONDS : 45;
            currentX -= speed * dt;
            normalizeCurrentX();
            applyTransform();
          }
        }
      }

      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
  }

  // 2. OBSŁUGA MODALU I FORMULARZA DODAWANIA OPINII
  function initReviewModal() {
    const modal = document.getElementById('reviewModal');
    const openBtn = document.getElementById('openReviewModalBtn');
    const closeBtn = document.getElementById('closeReviewModalBtn');
    const cancelBtn = document.getElementById('cancelModalBtn');
    const successCloseBtn = document.getElementById('successCloseBtn');
    const form = document.getElementById('reviewForm') as HTMLFormElement | null;
    const successView = document.getElementById('successView');
    const feedbackBox = document.getElementById('formFeedback');
    const contentInput = document.getElementById('contentInput') as HTMLTextAreaElement | null;
    const charCounter = document.getElementById('charCounter');
    const submitBtn = document.getElementById('submitReviewBtn') as HTMLButtonElement | null;
    const btnSpinner = document.getElementById('btnSpinner');

    if (!modal || !openBtn || !form) return;

    // Unikamy powtórnego bindowania listenerów
    if ((modal as any)._modalBound) return;
    (modal as any)._modalBound = true;

    // Otwieranie modalu
    function openModal() {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Reset powiadomień
      if (feedbackBox) {
        feedbackBox.style.display = 'none';
        feedbackBox.className = 'form-feedback';
        feedbackBox.textContent = '';
      }
    }

    // Zamykanie modalu
    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      // Reset ewentualnego ekranu sukcesu
      setTimeout(() => {
        if (successView) successView.style.display = 'none';
        if (form) form.style.display = 'flex';
      }, 300);
    }

    openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
    if (successCloseBtn) successCloseBtn.addEventListener('click', closeModal);

    // Zamknięcie po kliknięciu w tło modalu
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Zamknięcie klawiszem Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Licznik znaków w polu tekstowym
    if (contentInput && charCounter) {
      contentInput.addEventListener('input', () => {
        charCounter.textContent = `${contentInput.value.length} / 1000`;
      });
    }

    // Obsługa interaktywnych gwiazdek
    const starButtons = modal.querySelectorAll('.star-btn');
    const ratingInput = document.getElementById('ratingInput') as HTMLInputElement | null;
    const ratingLabel = document.getElementById('starRatingLabel');

    let currentRating = 5;

    const ratingLabelsMap: Record<number, string> = {
      5: '5.0 / 5 — Doskonale! ⭐',
      4: '4.0 / 5 — Bardzo dobrze! 👍',
      3: '3.0 / 5 — Dobrze 🙂',
      2: '2.0 / 5 — Przeciętnie 😐',
      1: '1.0 / 5 — Niezadowolony 🙁',
    };

    function updateStarsDisplay(rating: number) {
      starButtons.forEach((btn) => {
        const starVal = Number(btn.getAttribute('data-star'));
        const svg = btn.querySelector('svg');
        if (svg) {
          svg.setAttribute('fill', starVal <= rating ? '#F59E0B' : '#E5E7EB');
        }
        btn.setAttribute('aria-checked', starVal === rating ? 'true' : 'false');
      });
      if (ratingLabel) {
        ratingLabel.textContent = ratingLabelsMap[rating] || `${rating}.0 / 5`;
      }
    }

    starButtons.forEach((btn) => {
      const starVal = Number(btn.getAttribute('data-star'));

      // Hover
      btn.addEventListener('mouseenter', () => {
        updateStarsDisplay(starVal);
      });

      // Opuszczenie hover
      btn.addEventListener('mouseleave', () => {
        updateStarsDisplay(currentRating);
      });

      // Kliknięcie i wybór oceny
      btn.addEventListener('click', () => {
        currentRating = starVal;
        if (ratingInput) ratingInput.value = String(starVal);
        updateStarsDisplay(currentRating);
      });
    });

    // Obsługa wyboru szybkich cech (Tagów)
    const tagButtons = modal.querySelectorAll('.tag-toggle-btn');
    tagButtons.forEach((tagBtn) => {
      tagBtn.addEventListener('click', () => {
        tagBtn.classList.toggle('is-active');
      });
    });

    // Obsługa wysyłki formularza (AJAX / POST do /api/dodaj-opinie)
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (feedbackBox) {
        feedbackBox.style.display = 'none';
        feedbackBox.className = 'form-feedback';
        feedbackBox.textContent = '';
      }

      const authorInput = document.getElementById('authorInput') as HTMLInputElement | null;
      const roleInput = document.getElementById('roleInput') as HTMLInputElement | null;

      const author = authorInput?.value.trim() || '';
      const role = roleInput?.value.trim() || '';
      const content = contentInput?.value.trim() || '';
      const rating = currentRating;

      // Zbieranie zaznaczonych tagów
      const selectedTags: string[] = [];
      modal.querySelectorAll('.tag-toggle-btn.is-active').forEach((btn) => {
        const tag = btn.getAttribute('data-tag');
        if (tag) selectedTags.push(tag);
      });

      // Walidacja frontendowa
      if (!author) {
        showError('Podaj swoje imię i nazwisko lub pseudonim.');
        authorInput?.focus();
        return;
      }

      if (!content) {
        showError('Treść opinii nie może być pusta.');
        contentInput?.focus();
        return;
      }

      // Stan ładowania przycisku
      setLoading(true);

      try {
        const response = await fetch('/api/dodaj-opinie', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            author,
            role,
            rating,
            tags: selectedTags,
            content,
          }),
        });

        let result: any = null;
        try {
          result = await response.json();
        } catch (jsonErr) {
          console.warn('Odpowiedź serwera nie jest poprawnym JSON:', jsonErr);
        }

        if (!response.ok || !result?.success) {
          const errMsg =
            result?.error ||
            `Wystąpił błąd podczas wysyłania opinii (status: ${response.status} ${response.statusText || ''}). Spróbuj ponownie.`;
          showError(errMsg);
          setLoading(false);
          return;
        }

        // Sukces: reset formularza i pokazanie podziękowania
        form.reset();
        currentRating = 5;
        if (ratingInput) ratingInput.value = '5';
        updateStarsDisplay(5);
        tagButtons.forEach((btn) => btn.classList.remove('is-active'));
        if (charCounter) charCounter.textContent = '0 / 1000';

        form.style.display = 'none';
        if (successView) successView.style.display = 'block';
      } catch (err) {
        console.error('Błąd połączenia z API opinii:', err);
        showError('Nie udało się nawiązać połączenia z serwerem. Sprawdź połączenie z internetem i spróbuj ponownie.');
      } finally {
        setLoading(false);
      }
    });

    function showError(message: string) {
      if (feedbackBox) {
        feedbackBox.textContent = message;
        feedbackBox.className = 'form-feedback is-error';
        feedbackBox.style.display = 'block';
        feedbackBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function setLoading(isLoading: boolean) {
      if (!submitBtn) return;
      submitBtn.disabled = isLoading;
      const btnText = submitBtn.querySelector('.btn-text');
      if (btnSpinner) btnSpinner.style.display = isLoading ? 'inline-block' : 'none';
      if (btnText) btnText.textContent = isLoading ? 'Wysyłanie...' : 'Wyślij opinię';
    }
  }

  function initAll() {
    initTestimonialsSlider();
    initReviewModal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
  document.addEventListener('astro:page-load', initAll);
</script>
