---
import { sanityClient } from 'sanity:client';

// Link do wizytówki Google Maps
const googleMapsUrl = "https://g.page/r/TWÓJ_LINK_DO_OPINII/review";

// 1. ZAPYTANIE GROQ: Pobieramy tylko zatwierdzone opinie (approved == true) posortowane od najnowszych
let sanityOpinie: any[] = [];
try {
  sanityOpinie = await sanityClient.fetch(`
    *[_type == "opinia" && approved == true] | order(_createdAt desc) {
      _id,
      author,
      role,
      rating,
      tags,
      content,
      _createdAt
    }
  `);
} catch (error) {
  console.warn("Błąd pobierania opinii z Sanity (lub brak połączenia):", error);
}

// 2. Domyślne opinie z Google (wyświetlane jako uzupełnienie karuzeli)
const googleReviews = [
  {
    id: "g-1",
    name: "Michał D.",
    role: "Właściciel firmy",
    avatar: "",
    rating: 5,
    ratingDisplay: "5.0",
    text: "Nasz trawnik przed firmą zawsze był traktowany po macoszemu przez poprzednie ekipy. Nowa firma dba o niego jak o własny — zieleń wygląda perfekcyjnie przez cały rok.",
    tags: ["Fachowe doradztwo", "Piękny efekt"],
    isGoogle: true
  },
  {
    id: "g-2",
    name: "Karolina L.",
    role: "Klient indywidualny",
    avatar: "",
    rating: 5,
    ratingDisplay: "5.0",
    text: "Świetna komunikacja i uczciwe ceny. Jedyny powód, dla którego to nie jest pełne 5+, to małe przesunięcie terminu w bardzo zajętym tygodniu wiosennym — ale uprzedzili nas o tym z wyprzedzeniem.",
    tags: ["Szybka realizacja", "Fachowe doradztwo"],
    isGoogle: true
  },
  {
    id: "g-3",
    name: "Dariusz P.",
    role: "Zarządca obiektu",
    avatar: "",
    rating: 5,
    ratingDisplay: "5.0",
    text: "Zajmują się naszym komercyjnym placem przez całą zimę. Konsekwentne odśnieżanie za każdym razem, co naprawdę ma ogromne znaczenie, dopóki tego nie zabraknie.",
    tags: ["Terminowość", "Zostawiony porządek"],
    isGoogle: true
  },
  {
    id: "g-4",
    name: "Anna W.",
    role: "Właścicielka domu",
    avatar: "",
    rating: 5,
    ratingDisplay: "5.0",
    text: "Trawnik nigdy nie wyglądał tak zdrowo i gęsto. Profesjonalne doradztwo w zakresie nawożenia i nawadniania to strzał w dziesiątkę. Polecam każdemu z czystym sumieniem.",
    tags: ["Fachowe doradztwo", "Piękny efekt"],
    isGoogle: true
  }
];

// Mapujemy zatwierdzone opinie z Sanity
const mappedSanityReviews = (sanityOpinie || []).map((item) => {
  const r = typeof item.rating === 'number' ? Math.min(5, Math.max(1, item.rating)) : 5;
  return {
    id: item._id,
    name: item.author || "Anonimowy Klient",
    role: item.role || "Klient",
    avatar: "", // Elegancki awatar z inicjałem
    rating: r,
    ratingDisplay: `${r}.0`,
    text: item.content || "",
    tags: Array.isArray(item.tags) ? item.tags : [],
    isGoogle: false
  };
});

// Wyświetlamy opinie z Sanity; jeśli jest ich mniej niż 4, uzupełniamy bazą Google
const allReviews = mappedSanityReviews.length >= 4
  ? mappedSanityReviews
  : [...mappedSanityReviews, ...googleReviews];
---

<section class="testimonials-section" id="opinie">
  <div class="container">
    
    <!-- NAGŁÓWEK -->
    <div class="section-header">
      <div class="header-left">
        <span class="kicker"><span class="dot"></span> OPINIE KLIENTÓW</span>
        <h2>Co mówią o nas<br><span class="italic-text">nasi klienci</span></h2>
      </div>
      
      <div class="header-right">
        <p>Dbamy o cały cykl sezonowy — bez konieczności żonglowania wieloma wykonawcami.</p>
        
        <div class="header-actions">
          <!-- Przycisk dodawania nowej opinii -->
          <button type="button" class="btn-add-review" id="openReviewModalBtn" aria-haspopup="dialog">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Dodaj opinię</span>
          </button>

          <!-- Strzałki z projektu (link do Google) -->
          <div class="arrows-container">
            <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="arrow-btn arrow-prev" aria-label="Zobacz na Google">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </a>
            <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="arrow-btn arrow-next" aria-label="Napisz opinię na Google">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SLIDER (WAGONIKI Z PĘTLĄ NIESKOŃCZONĄ) -->
  <div class="slider-wrapper" id="testimonialsSlider">
    <div class="slider-inner" id="testimonialsInner">
      {[1, 2, 3, 4].map((trackNum) => (
        <div class="slider-track" data-track={trackNum} aria-hidden={trackNum > 1 ? "true" : undefined}>
          {allReviews.map((review) => (
            <div class="review-card">
              
              <div class="card-top">
                <div class="author-info">
                  {review.avatar ? (
                    <img src={review.avatar} alt={review.name} class="avatar" loading="lazy" draggable="false" />
                  ) : (
                    <div class="avatar-fallback" aria-hidden="true">
                      {review.name ? review.name.trim().charAt(0).toUpperCase() : 'K'}
                    </div>
                  )}
                  <div class="author-text">
                    <span class="author-name">{review.name}</span>
                    <span class="author-role">{review.role}</span>
                  </div>
                </div>
                <div class="rating-number">{review.ratingDisplay}</div>
              </div>

              <div class="card-middle">
                <svg class="quote-icon" width="28" height="28" viewBox="0 0 24 24" fill="#e5e7eb" xmlns="http://www.w3.org/2000/svg">
                  <path d="M14.017 18L14.017 10.609C14.017 4.905 17.748 1.039 23 0L23.995 2.151C21.563 3.068 20 5.789 20 8H24V18H14.017ZM0 18V10.609C0 4.905 3.748 1.038 9 0L9.996 2.151C7.563 3.068 6 5.789 6 8H9.983L9.983 18L0 18Z"/>
                </svg>
                <p class="review-text">{review.text}</p>

                {review.tags && review.tags.length > 0 && (
                  <div class="card-chips">
                    {review.tags.map((tag: string) => (
                      <span class="tag-chip">{tag}</span>
                    ))}
                  </div>
                )}
              </div>

              <div class="card-bottom">
                {review.isGoogle ? (
                  <div class="source-brand" title="Opinia z Google">
                    <svg width="22" height="22" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                      <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                      <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                      <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    <span class="source-label">Google</span>
                  </div>
                ) : (
                  <div class="source-brand client-source" title="Zweryfikowana opinia klienta">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2d4a22" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                    <span class="source-label">Zweryfikowana</span>
                  </div>
                )}

                <div class="stars-container" aria-label={`Ocena: ${review.rating} z 5`}>
                  {[1, 2, 3, 4, 5].map((starNum) => (
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill={starNum <= review.rating ? "#F59E0B" : "#E5E7EB"}
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                    </svg>
                  ))}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="verified-icon" title="Zweryfikowana">
                    <circle cx="12" cy="12" r="10" fill="#3B82F6"/>
                    <path d="M8 12L11 15L16 9" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
              
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MODAL FORMULARZA OPINII -->
<div class="review-modal-backdrop" id="reviewModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-dialog">
    <button type="button" class="modal-close-btn" id="closeReviewModalBtn" aria-label="Zamknij okno">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-header">
      <span class="modal-kicker"><span class="dot"></span> TWOJA OPINIA</span>
      <h3 id="modalTitle">Dodaj swoją opinię</h3>
      <p class="modal-subtitle">Twoja recenzja pomoże nam stale podnosić jakość naszych usług ogrodniczych.</p>
    </div>

    <!-- Pudełko na komunikaty błędów lub powiadomień -->
    <div class="form-feedback" id="formFeedback" style="display: none;" role="alert"></div>

    <!-- Formularz dodawania opinii -->
    <form id="reviewForm" class="review-form" novalidate>
      <div class="form-row">
        <div class="form-group">
          <label for="authorInput">Imię i nazwisko / Nick <span class="required">*</span></label>
          <input
            type="text"
            id="authorInput"
            name="author"
            placeholder="np. Karolina Nowak"
            required
            maxlength="100"
            autocomplete="name"
          />
        </div>
        <div class="form-group">
          <label for="roleInput">Rola / Miejscowość <span class="optional">(opcjonalnie)</span></label>
          <input
            type="text"
            id="roleInput"
            name="role"
            placeholder="np. Właściciel ogrodu"
            maxlength="80"
          />
        </div>
      </div>

      <!-- Interaktywna ocena gwiazdkowa (1-5) -->
      <div class="form-group">
        <label>Twoja ocena <span class="required">*</span></label>
        <div class="star-rating-widget">
          <div class="star-rating-stars" id="starRatingStars" role="radiogroup" aria-label="Wybierz ocenę od 1 do 5">
            {[1, 2, 3, 4, 5].map((star) => (
              <button
                type="button"
                class="star-btn is-active"
                data-star={star}
                role="radio"
                aria-checked={star === 5 ? "true" : "false"}
                aria-label={`${star} gwiazdek z 5`}
              >
                <svg width="28" height="28" viewBox="0 0 24 24" fill="#F59E0B" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                </svg>
              </button>
            ))}
          </div>
          <span class="star-rating-label" id="starRatingLabel">5.0 / 5 — Doskonale! ⭐</span>
          <input type="hidden" id="ratingInput" name="rating" value="5" />
        </div>
      </div>

      <!-- Szybkie cechy (Tagi - klikalne przyciski) -->
      <div class="form-group">
        <label>Szybkie cechy (wybierz pasujące atuty)</label>
        <div class="tags-selector" id="tagsSelector">
          {[
            'Fachowe doradztwo',
            'Szybka realizacja',
            'Zostawiony porządek',
            'Terminowość',
            'Piękny efekt',
          ].map((tag) => (
            <button type="button" class="tag-toggle-btn" data-tag={tag}>
              <span class="tag-check-icon">✓</span>
              <span class="tag-text">{tag}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Treść opinii -->
      <div class="form-group">
        <div class="label-with-counter">
          <label for="contentInput">Treść opinii <span class="required">*</span></label>
          <span class="char-counter" id="charCounter">0 / 1000</span>
        </div>
        <textarea
          id="contentInput"
          name="content"
          rows="4"
          placeholder="Napisz kilka słów o przebiegu prac, kontakcie i efekcie w ogrodzie..."
          required
          maxlength="1000"
        ></textarea>
      </div>

      <!-- Notka o zatwierdzeniu moderacji -->
      <div class="moderation-info">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2d4a22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>Opinia przed pojawieniem się na stronie zostanie zweryfikowana przez właściciela.</span>
      </div>

      <!-- Przyciski akcji -->
      <div class="modal-footer">
        <button type="button" class="btn-cancel" id="cancelModalBtn">Anuluj</button>
        <button type="submit" class="btn-submit" id="submitReviewBtn">
          <span class="btn-text">Wyślij opinię</span>
          <span class="btn-spinner" id="btnSpinner" style="display: none;"></span>
        </button>
      </div>
    </form>

    <!-- Sukces: Ekran podziękowania po pomyślnym przesłaniu -->
    <div class="success-view" id="successView" style="display: none;">
      <div class="success-icon-wrap">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </div>
      <h4>Dziękujemy za przesłanie opinii!</h4>
      <p>Twoja opinia została bezpiecznie zapisana. Po krótkiej weryfikacji w panelu Sanity przez właściciela pojawi się w karuzeli na stronie głównej.</p>
      <button type="button" class="btn-success-close" id="successCloseBtn">Zamknij</button>
    </div>
  </div>
</div>

<style>
  .testimonials-section {
    padding: 100px 0;
    background-color: #f8faf8;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* --- NAGŁÓWEK --- */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    gap: 40px;
    width: 100%;
    box-sizing: border-box;
  }

  .header-left {
    max-width: 640px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #86b942;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 14px;
  }

  .dot {
    width: 8px;
    height: 8px;
    background-color: #86b942; 
    border-radius: 50%;
    display: inline-block;
  }

  .header-left h2 {
    font-size: clamp(2.1rem, 4.5vw, 3.2rem);
    line-height: 1.15;
    color: #153c24;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .italic-text {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 600;
    color: #86b942;
  }

  .header-right {
    max-width: 440px;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
  }

  .header-right p {
    color: #6b7280;
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /* Przycisk Dodaj opinię */
  .btn-add-review {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #86b942;
    color: #0c2b20;
    font-size: 0.92rem;
    font-weight: 700;
    padding: 11px 22px;
    border-radius: 9999px;
    border: 1px solid #86b942;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(134, 185, 66, 0.25);
    font-family: inherit;
  }

  .btn-add-review:hover {
    background-color: #92c949;
    color: #061711;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(134, 185, 66, 0.35);
  }

  .btn-add-review:active {
    transform: translateY(0);
  }

  /* Guziki nawigacji (strzałki ze screena) */
  .arrows-container {
    display: flex;
    gap: 10px;
  }

  .arrow-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid #e5e7eb;
  }

  .arrow-prev {
    background-color: #ffffff;
    color: #1a1a1a;
  }
  .arrow-prev:hover {
    background-color: #f3f4f6;
  }

  .arrow-next {
    background-color: #1f3318;
    color: #ffffff;
    border-color: #1f3318;
  }
  .arrow-next:hover {
    background-color: #2d4a22;
  }

  /* --- SLIDER WAGONIKI --- */
  .slider-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 20px 0 40px 0;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }

  .slider-wrapper.is-dragging {
    cursor: grabbing;
  }

  .slider-wrapper.is-dragging .review-card {
    pointer-events: none;
  }

  .slider-inner {
    display: flex;
    gap: 24px;
    width: max-content;
    will-change: transform;
  }

  .slider-track {
    display: flex;
    gap: 24px;
    flex-shrink: 0;
    width: max-content;
  }

  /* --- KARTY OPINII --- */
  .review-card {
    width: 380px;
    flex: 0 0 380px;
    background-color: #ffffff;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.02);
    border: 1px solid #f3f4f6;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 340px;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(0,0,0,0.07);
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
    user-drag: none;
  }

  /* Awatar z inicjałem (fallback dla dodanych opinii) */
  .avatar-fallback {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #153c24 0%, #86b942 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.15rem;
    flex-shrink: 0;
    user-select: none;
    box-shadow: 0 2px 8px rgba(12, 43, 32, 0.2);
  }

  .author-text {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 700;
    color: #1a1a1a;
    font-size: 1.05rem;
  }

  .author-role {
    font-size: 0.85rem;
    color: #6b7280;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rating-number {
    font-size: 2.2rem;
    font-weight: 400;
    color: #1a1a1a;
    line-height: 1;
    letter-spacing: -1px;
  }

  /* ŚRODEK KARTY (Cytat, Tekst, Plakietki tagów) */
