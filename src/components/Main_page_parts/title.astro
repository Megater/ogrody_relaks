---
import { Image } from 'astro:assets';
import main_photo from '../../assets/images/Kamil_title_photo.jpg';
import profile from '../../assets/images/Kamil_cut.png';
import sprzet from '../../assets/images/kosiara.jpg';

// Starannie dobrane portrety zadowolonych klientów
const clientAvatars = [
  "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=120&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=120&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=120&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=120&auto=format&fit=crop"
];
---

<section class="hero-section" id="start" aria-label="Sekcja powitalna Ogrody Relaks">
    <!-- 1. Zdjęcie w tle o wysokim priorytecie (LCP) -->
    <Image 
        src={main_photo} 
        class="hero-bg" 
        alt="Zadbany, zielony ogród - tło sekcji" 
        loading="eager"
        fetchpriority="high"
    />
    
    <!-- 2. Stonowane, ciepłe warstwy nasycenia, głębi i winiety (z-index 2 i 3) -->
    <div class="hero-overlay-dark" aria-hidden="true"></div>
    <div class="hero-overlay-radial" aria-hidden="true"></div>
    <div class="hero-overlay-bottom" aria-hidden="true"></div>

    <!-- 3. Główna zawartość w responsywnej siatce -->
    <div class="hero-container">
        
        <!-- Płynny gradient na telefonie: przykrywa tułów Kamila, a pod tekstem przechodzi w pełną zieleń -->
        <div class="hero-mobile-gradient" aria-hidden="true"></div>
        
        <!-- KOLUMNA 1: Treść (Na desktopie po lewej, na mobile wsuwa się pod Kamila od łokci) -->
        <div class="hero-text-box">
            
            <!-- Kicker / Subtelna pastylka informacyjna -->
            <div class="kicker-pill">
                <span class="pulsing-dot" aria-hidden="true"></span>
                <span class="kicker-text">Profesjonalne Usługi Ogrodnicze • Grójec i okolice</span>
            </div>

            <!-- Nagłówek H1 - stonowany, bez neonowego świecenia -->
            <h1 class="hero-title">
                Kompleksowa pielęgnacja i&nbsp;zakładanie ogrodów <span class="highlight">od&nbsp;A do&nbsp;Z.</span>
            </h1>

            <!-- Opis oferty -->
            <p class="hero-description">
                Dbamy o wspaniałe przestrzenie, które wnoszą piękno, wartość i spokój do Twojego otoczenia każdego dnia. Od regularnego koszenia i aeracji po zaawansowane systemy nawadniania i pełne aranżacje.
            </p>
            
            <!-- Grupa przycisków akcji CTA -->
            <div class="cta-group">
                <a href="#rezerwacja" class="cta-button primary">
                    <span>Rozpocznij projekt</span>
                    <span class="arrow" aria-hidden="true">→</span>
                </a>

                <a href="tel:+48516753132" class="cta-button secondary" aria-label="Zadzwoń: +48 516 753 132">
                    <span class="phone-icon-box" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </span>
                    <div class="phone-info">
                        <span class="phone-tag">Zadzwoń do nas</span>
                        <span class="phone-num">+48 516 753 132</span>
                    </div>
                </a>
            </div>

            <!-- Sekcja zadowolonych klientów i opinie -->
            <div class="happy-clients">
                <div class="avatars-cluster" aria-hidden="true">
                    {clientAvatars.map((src, i) => (
                        <img 
                            src={src} 
                            alt={`Klient ${i + 1}`} 
                            class="avatar-img" 
                            width="44" 
                            height="44" 
                            loading="lazy" 
                        />
                    ))}
                    <div class="avatar-badge">+120</div>
                </div>

                <div class="clients-meta">
                    <div class="stars-row">
                        <span class="stars" aria-label="5 gwiazdek">★★★★★</span>
                        <strong class="rating-grade">5.0</strong>
                    </div>
                    <span class="clients-label">Ponad 120 zadowolonych klientów</span>
                </div>
            </div>

            <!-- Mikro-lista kluczowych atutów i gwarancji -->
            <div class="hero-features">
                <div class="feature-item highlight-feature">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#86b942" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                    <span><strong>100% Gwarancji</strong> satysfakcji</span>
                </div>
                <div class="feature-item">
                    <span class="feature-emoji" aria-hidden="true">🌱</span>
                    <span><strong>10+ lat</strong> doświadczenia</span>
                </div>
                <div class="feature-item">
                    <span class="feature-emoji" aria-hidden="true">🚜</span>
                    <span>Własny park maszyn</span>
                </div>
                <div class="feature-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#86b942" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Darmowa wycena i dojazd</span>
                </div>
            </div>

        </div>

        <!-- KOLUMNA 2: Sylwetka Kamila (Na desktopie duża i okazała z odznakami, na mobile powiększona i wygaszająca się na wysokości łokci) -->
        <div class="hero-visual-column">
            
            <div class="profile-stage">
                
                <!-- Ciepła, stonowana poświata za sylwetką -->
                <div class="stage-ambient-glow" aria-hidden="true"></div>

                <!-- Zdjęcie Kamila -->
                <Image 
                    src={profile} 
                    class="profile-cutout" 
                    alt="Kamil Salmonowicz - Właściciel Ogrody Relaks"
                    loading="eager"
                    format="png" 
                />

                <!-- Pływające odznaki - widoczne WYŁĄCZNIE na ekranach desktopowych -->
                <div class="floating-badge badge-guarantee">
                    <div class="badge-icon-circle">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <polyline points="9 12 11 14 15 10"></polyline>
                        </svg>
                    </div>
                    <div class="badge-text-box">
                        <span class="badge-headline">Gwarancja 100%</span>
                        <span class="badge-subline">Satysfakcji z usługi</span>
                    </div>
                </div>

                <div class="floating-badge badge-experience">
                    <span class="exp-icon">🌱</span>
                    <span class="exp-text"><strong>10+ lat</strong> doświadczenia</span>
                </div>

                <div class="floating-badge badge-equipment">
                    <div class="equip-image-wrap">
                        <Image 
                            src={sprzet}
                            class="equip-image"
                            alt="Profesjonalny sprzęt ogrodniczy"
                            width={130}
                            height={130}
                        />
                    </div>
                    <div class="equip-text-box">
                        <span class="equip-tag">Sprzęt PRO</span>
                        <strong class="equip-name">Własny park maszyn</strong>
                        <span class="equip-desc">Kosiarki, aeratory i traktory</span>
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>

<style>
    /* =========================================================
       0. RESET I PODSTAWA BOX-SIZING
       ========================================================= */
    *, *::before, *::after {
        box-sizing: border-box;
    }

    /* =========================================================
       1. BAZA SEKCJI HERO
       ========================================================= */
    .hero-section {
        position: relative;
        width: 100%;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: stretch;
        justify-content: center;
        overflow-x: hidden;
        overflow-y: hidden;
        background-color: #0c2b20;
        font-family: 'Inter', sans-serif;
        padding-top: clamp(75px, 9vh, 95px);
        padding-bottom: 0;
        box-sizing: border-box;
    }

    /* Zdjęcie w tle */
    .hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        z-index: 1;
        filter: brightness(0.72) saturate(1.05);
        transform: scale(1.02);
    }

    /* Przytulne warstwy nasycenia i winiety (Desktop: od prawej przezroczysty, od lewej pełny zielony) */
    .hero-overlay-dark {
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background: linear-gradient(
            to right,
            #0c2b20 0%,
            #0c2b20 38%,
            rgba(12, 43, 32, 0.94) 48%,
            rgba(12, 43, 32, 0.6) 62%,
            rgba(12, 43, 32, 0.2) 78%,
            transparent 90%,
            transparent 100%
        );
    }

    .hero-overlay-radial {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        background: radial-gradient(
            ellipse at 80% 60%,
            rgba(134, 185, 66, 0.06) 0%,
            transparent 65%
        );
    }

    /* Przejście do kolejnej sekcji */
    .hero-overlay-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 90px;
        z-index: 2;
        pointer-events: none;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(12, 43, 32, 0.75) 65%,
            #fafafa 100%
        );
    }

    /* Mobilny gradient domyślnie ukryty na desktopie */
    .hero-mobile-gradient {
        display: none;
    }

    /* =========================================================
       2. GŁÓWNY KONTENER I SIATKA (DESKTOP)
       ========================================================= */
    .hero-container {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 1640px; /* Zwiększona szerokość dająca przestrzeń na dużą postać */
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 3vw, 3.5rem);
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(1.5rem, 3vw, 3.5rem);
        align-items: end;
        min-height: calc(100dvh - 85px);
        box-sizing: border-box;
    }

    /* =========================================================
       3. LEWA KOLUMNA: TEKST I KONTENT
       ========================================================= */
    .hero-text-box {
        position: relative;
        z-index: 12;
        width: 100%;
        max-width: 740px;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-self: center;
        padding: 2.5rem 0 3.5rem 0;
        box-sizing: border-box;
    }

    /* Pastylka / Kicker */
    .kicker-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #c5ded1;
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        width: fit-content;
        max-width: 100%;
        margin-bottom: 1.25rem;
        box-sizing: border-box;
    }

    .pulsing-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #86b942;
        flex-shrink: 0;
    }

    /* Tytuł H1 */
    .hero-title {
        font-size: clamp(2.35rem, 4.3vw, 4.1rem);
        line-height: 1.14;
        font-weight: 800;
        margin: 0 0 1.25rem 0;
        letter-spacing: -0.025em;
        color: #ffffff;
        text-wrap: balance;
        overflow-wrap: break-word;
        word-break: break-word;
    }

    .highlight {
        color: #9ecc5e;
        display: inline-block;
    }

    /* Opis */
    .hero-description {
        font-size: clamp(1.05rem, 1.4vw, 1.22rem);
        line-height: 1.62;
        color: #d8e4dc;
        margin: 0 0 2.25rem 0;
        max-width: 620px;
        overflow-wrap: break-word;
    }

    /* Grupa przycisków CTA */
    .cta-group {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        margin-bottom: 2.5rem;
        width: 100%;
        box-sizing: border-box;
    }

    .cta-button {
        text-decoration: none;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-flex;
        align-items: center;
        border-radius: 50px;
        cursor: pointer;
        box-sizing: border-box;
        max-width: 100%;
    }

    .cta-button.primary {
        gap: 0.85rem;
        background-color: #86b942;
        color: #ffffff;
        font-weight: 700;
        font-size: 1.05rem;
        padding: 1.05rem 2.25rem;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.24);
    }

    .cta-button.primary:hover {
        background-color: #76a537;
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.32);
    }

    .cta-button.primary .arrow {
        font-size: 1.25rem;
        transition: transform 0.2s ease;
        line-height: 1;
    }

    .cta-button.primary:hover .arrow {
        transform: translateX(4px);
    }

    .cta-button.secondary {
        gap: 0.85rem;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #ffffff;
        padding: 0.75rem 1.6rem;
    }

    .cta-button.secondary:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.28);
        transform: translateY(-2px);
    }

    .phone-icon-box {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(134, 185, 66, 0.22);
        color: #a0ce62;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .phone-info {
        display: flex;
        flex-direction: column;
        text-align: left;
    }

    .phone-tag {
        font-size: 0.72rem;
        color: #b5c7bd;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .phone-num {
        font-size: 0.95rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.02em;
    }

    /* Social proof: Zadowoleni klienci */
    .happy-clients {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        width: 100%;
        box-sizing: border-box;
    }

    .avatars-cluster {
        display: flex;
        align-items: center;
    }

    .avatar-img {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2.5px solid #0c2b20;
        margin-left: -12px;
        object-fit: cover;
        background-color: #244b3c;
    }

    .avatar-img:first-child {
        margin-left: 0;
    }

    .avatar-badge {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2.5px solid #0c2b20;
        margin-left: -12px;
        background-color: #86b942;
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .clients-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .stars-row {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .stars {
        color: #f59e0b;
        font-size: 1rem;
        letter-spacing: 1px;
    }

    .rating-grade {
        font-size: 0.95rem;
        font-weight: 800;
        color: #ffffff;
    }

    .clients-label {
        font-size: 0.85rem;
        color: #b8ccbf;
        font-weight: 500;
    }

    /* Cechy z ptaszkami pod spodem */
    .hero-features {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        width: 100%;
        box-sizing: border-box;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.86rem;
        font-weight: 600;
        color: #d1ded6;
    }

    .feature-item strong {
        color: #a0ce62;
    }

    .feature-emoji {
        font-size: 1.1rem;
        line-height: 1;
    }

    /* =========================================================
       4. PRAWA KOLUMNA (DESKTOP): DUŻA SYLWETKA KAMILA I PŁYWAJĄCE KARTY
       ========================================================= */
    .hero-visual-column {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        align-self: end;
        box-sizing: border-box;
    }

    .profile-stage {
        position: relative;
        width: 100%;
        max-width: 760px; /* Zwiększona szerokość sceny na dużą sylwetkę */
        display: flex;
        justify-content: center;
        align-items: flex-end;
        margin-bottom: 0;
        box-sizing: border-box;
    }

    /* Ciepła, subtelna poświata za Kamilem */
    .stage-ambient-glow {
        position: absolute;
        bottom: 15%;
        width: 520px;
        height: 520px;
        background: radial-gradient(circle, rgba(134, 185, 66, 0.1) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(65px);
        z-index: 1;
        pointer-events: none;
    }

    /* Zdjęcie Kamila - powiększone, okazałe, zajmuje 92vh */
    .profile-cutout {
        position: relative;
        z-index: 3;
        width: auto;
        max-width: 100%;
        height: clamp(680px, 92vh, 980px); /* Powiększony Kamil na monitorze */
        object-fit: contain;
        object-position: bottom center;
        display: block;
        margin: 0 auto;
        filter: drop-shadow(0 25px 50px rgba(0, 0, 0, 0.55));
        mask-image: linear-gradient(to top, transparent 0%, black 4%, black 100%);
        -webkit-mask-image: linear-gradient(to top, transparent 0%, black 4%, black 100%);
    }

    /* Wspólne style pływających odznak (WYŁĄCZNIE NA DESKTOP) */
    .floating-badge {
        position: absolute;
        z-index: 5;
        border-radius: 20px;
        backdrop-filter: blur(14px);
        box-shadow: 0 14px 32px rgba(0, 0, 0, 0.3);
        pointer-events: auto;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-sizing: border-box;
    }

    .floating-badge:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 18px 38px rgba(0, 0, 0, 0.38);
    }

    /* 1. Gwarancja Satysfakcji (Góra-Lewo przy ramieniu powiększonego Kamila) */
    .badge-guarantee {
        top: 28%;
        left: clamp(-65px, -4.5vw, -25px);
        background: rgba(14, 44, 34, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.16);
        padding: 12px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        animation: floatBadge1 5.5s ease-in-out infinite alternate;
    }

    .badge-icon-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #86b942;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .badge-text-box {
        display: flex;
        flex-direction: column;
    }

    .badge-headline {
        font-size: 0.94rem;
        font-weight: 800;
        color: #ffffff;
    }

    .badge-subline {
        font-size: 0.78rem;
        color: #a0ce62;
        font-weight: 600;
    }

    /* 2. Chip Doświadczenia (Dół-Lewo) */
    .badge-experience {
        bottom: 14%;
        left: clamp(-50px, -3.5vw, -20px);
        background: rgba(14, 44, 34, 0.94);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 10px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.88rem;
        color: #ffffff;
        border-radius: 50px;
        animation: floatBadge2 7s ease-in-out infinite alternate;
        box-shadow: 0 12px 26px rgba(0, 0, 0, 0.3);
    }

    .exp-icon {
        font-size: 1.15rem;
    }

    .exp-text strong {
        color: #a0ce62;
        font-weight: 800;
    }

    /* 3. Karta Sprzętu (Dół-Prawo) */
    .badge-equipment {
        bottom: 20%;
        right: clamp(-60px, -4vw, -20px);
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.9);
        padding: 11px 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        animation: floatBadge1 6.5s ease-in-out infinite alternate;
    }

    .equip-image-wrap {
        width: 66px;
        height: 66px;
        border-radius: 12px;
        overflow: hidden;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .equip-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .equip-text-box {
        display: flex;
        flex-direction: column;
    }

    .equip-tag {
