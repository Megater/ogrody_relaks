---
import { Image } from 'astro:assets';
import main_photo from '../../assets/images/Kamil_title_photo.jpg';
import profile from '../../assets/images/Kamil_cut.png';
import sprzet from '../../assets/images/kosiara.jpg';
---

<main class="hero-section">
    <!-- 1. Zdjęcie w tle -->
    <Image src={main_photo} class="hero-bg" alt="Tło ogrodu" />
    
    <!-- 2. Ciemna nakładka -->
    <div class="hero-overlay"></div>

    <!-- 3. Główna zawartość -->
    <div class="hero-content">
        
        <!-- Lewa strona: Tekst i przycisk -->
        <div class="hero-text-box">
            <h1>Kompleksowa pielęgnacja i zakładanie ogrodów od A do <span class="highlight">Z.</span></h1>
            <p>Dbamy o wspaniałe przestrzenie, które wnoszą piękno, wartość i harmonię do Twojego otoczenia każdego dnia.</p>
            
            <a href="#kontakt" class="cta-button">
                Rozpocznij <span class="arrow">→</span>
            </a>

            <!-- Sekcja zadowolonych klientów pod przyciskiem -->
            <div class="happy-clients">
                <div class="avatars">
                    <div class="avatar bg-gray"></div>
                    <div class="avatar bg-light"></div>
                    <div class="avatar bg-gray"></div>
                    <div class="avatar bg-light"></div>
                </div>
                <div class="clients-text">
                    <strong>120+</strong>
                    <span>Zadowolonych klientów</span>
                </div>
            </div>
        </div>

        <!-- Prawa strona: Miejsce na zdjęcie profilowe i elementy pływające -->
        <div class="hero-profile-box">
            
            <Image 
                src={profile} 
                class="profile" 
                alt="Kamil"
                format="png" 
            />

            <!-- Pływająca odznaka "Gwarancja Satysfakcji" -->
            <div class="badge-guarantee">
                <span class="icon">🌱</span>
                <span>Gwarancja<br>Satysfakcji</span>
            </div>

            <!-- Pływająca miniatura (kafelek ze sprzętem) -->
            <div class="badge-floating-card">
                <Image 
                    src={sprzet}
                    class="sprzet"
                    alt="Sprzęt"
                />
            </div>

        </div>
    </div>
</main>

<style>
    /* Reset i ogólne ustawienia */
    * {
        box-sizing: border-box;
    }

    /* 1. SEKCJA GŁÓWNA (DESKTOP BEZ ZMIAN) */
    .hero-section {
        position: relative;
        min-width: 100vw;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #0c3b2e;
        font-family: 'Inter', sans-serif;
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover;
        z-index: 1;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(12, 30, 20, 0.85) 35%, rgba(12, 30, 20, 0.4) 75%, rgba(0, 0, 0, 0.1) 100%);
        z-index: 2;
        pointer-events: none;
    }

    /* 2. KONTENER Z ZAWARTOŚCIĄ (DESKTOP BEZ ZMIAN) */
    .hero-content {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 1280px;
        height: 100vh;
        min-height: 700px;
        padding: 0 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* 3. LEWA STRONA - TEKST (DESKTOP BEZ ZMIAN) */
    .hero-text-box {
        width: auto;
        max-width: 650px;
        color: #ffffff;
    }

    .hero-text-box h1 {
        font-size: 3.5rem;
        line-height: 1.15;
        font-weight: 800;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
    }

    .highlight {
        color: #c4f07a;
    }

    .hero-text-box p {
        font-size: 1.5rem;
        line-height: 1.6;
        color: #e5e5e5;
        margin-bottom: 2.5rem;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background-color: #c4f07a;
        color: #0c3b2e;
        text-decoration: none;
        font-weight: 700;
        font-size: 1rem;
        padding: 1rem 2rem;
        border-radius: 50px;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .cta-button:hover {
        transform: translateY(-2px);
        background-color: #d1f593;
    }

    .arrow {
        font-size: 1.2rem;
        transition: transform 0.2s ease;
    }

    .cta-button:hover .arrow {
        transform: translateX(4px);
    }

    .happy-clients {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 3rem;
    }

    .avatars {
        display: flex;
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid #0c3b2e;
        margin-left: -12px;
    }

    .avatar:first-child { margin-left: 0; }
    .bg-gray { background-color: #9ca3af; }
    .bg-light { background-color: #d1d5db; }

    .clients-text {
        display: flex;
        flex-direction: column;
        font-size: 0.85rem;
    }

    .clients-text strong {
        font-size: 1.1rem;
        font-weight: 800;
    }

    .clients-text span {
        color: #d1d5db;
    }

    /* 4. PRAWA STRONA - PROFIL (DESKTOP BEZ ZMIAN) */
    .hero-profile-box {
        position: absolute;
        right: 2rem;
        bottom: 0;
        width: 520px;
        height: 85vh;
        max-height: 800px;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        pointer-events: none;
    }

    .profile {
        position: absolute;
        bottom: -20px;
        width: auto !important;
        height: 110% !important;
        object-fit: contain;
        object-position: bottom center;
        display: block;
        z-index: 4;
    }

    .badge-guarantee {
        position: absolute;
        bottom: 120px;
        right: -90px;
        background-color: #0c3b2e;
        color: #c4f07a;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        border: 4px solid #c4f07a;
        font-size: 0.75rem;
        font-weight: 700;
        line-height: 1.2;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        z-index: 5;
    }

    .badge-guarantee .icon {
        font-size: 1.5rem;
        margin-bottom: 0.2rem;
    }

    .badge-floating-card {
        position: absolute;
        bottom: 10px;
        right: -40px;
        width: 180px;
        height: 180px;
        background-color: #ffffff;
        border-radius: 16px;
        border: 4px solid #e5e5e5;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 0.85rem;
        font-weight: bold;
        color: #6b7280;
        box-shadow: 0 15px 30px rgba(0,0,0,0.4);
        z-index: 4;
        box-sizing: content-box;
    }

    .sprzet {
        position: absolute;
        inset: 0;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover;
        border-radius: 10%;
    }

    /* =======================================================
       TYLKO WIDOK MOBILNY (Telefony i małe ekrany)
       ======================================================= */
    @media (max-width: 1024px) {
        
        /* 1. NAKŁADKA (z-index: 3)
           - Zakrywa tło ogrodu ORAZ dolną część postaci Kamila
           - 'pointer-events: none' przepuszcza kliknięcia pod spód */
        .hero-overlay {
            z-index: 3;
            pointer-events: none;
            background: linear-gradient(
                to bottom,
                rgba(12, 30, 20, 0) 0%,
                rgba(12, 30, 20, 0.1) 30%,
                rgba(12, 30, 20, 1) 50%,
                rgba(12, 30, 20, 1) 100%,
                rgba(12, 30, 20, 1) 100%
            );
        }

        /* 2. GŁÓWNY KONTENER
           - Usuwamy wymuszony z-index, żeby elementy w środku mogły mieć własne warstwy */
        .hero-content {
            height: auto;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 8rem 1.5rem 3.5rem 1.5rem;
            position: relative;
            z-index: auto; /* Kluczowe! */
        }

        /* 3. POSTAĆ KAMILA (z-index: 2)
           - Leży POD .hero-overlay (który ma 3)
           - Dzięki temu gradient wchodzi na postać i płynnie gasi ją ku dołowi */
        .hero-profile-box {
            position: absolute;
            top:auto;
            left: 50%;
            transform: translateX(-50%);
            bottom: 38%;
            right: auto;
            margin: 0;
            z-index: 2; /* PONIŻEJ nakładki (3) */
            pointer-events: none;
            width: auto;
            height: 55vh;
        }

        .profile {
            position: absolute;
            height: auto;
            width: auto;
            bottom: -40;
            left: 50%;
            transform: translateX(-50%);
            object-fit: contain;
            object-position: top center;
            display: block;
            z-index: 2; /* Spójne z boksem */
        }

        /* 4. ODZNAKA SATYSFAKCJI (z-index: 5)
           - Na wierzchu, żeby była ostra i wyrazista obok ramienia */
        .badge-guarantee {
            position: absolute;
            top: 20vh;
            left: 20vw;
            right: auto;
            
            bottom: auto;
            width: 11vh;
            height: 11vh;
            font-size: 1.4vh;
            border-width: 2.5px;
            z-index: 5;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.4);
        }

        .badge-guarantee .icon {
            font-size: 2vh;
        }

        /* 5. UKRYCIE KAFELKA ZE SPRZĘTEM NA MOBILE */
        .badge-floating-card {
            display: none;
        }

        /* 6. TEKST I PRZYCISK (z-index: 10)
           - ZAWSZE na samej górze ponad ciemnym gradientem */
        .hero-text-box {
            position: relative;
            z-index: 10; /* NAJWYSZA warstwa */
            max-width: 100%;
            text-align: left;
            margin-top: 70vw; /* Przestrzeń u góry, by odsłonić twarz i ramiona */
            margin-bottom: auto;
            
        }

        .hero-text-box h1 {
            font-size: 7vw;
            line-height: 1.15;
            margin-bottom: 0.8rem;
        }

        .hero-text-box p {
            font-size: 5vw;
            line-height: 1.5;
            margin-bottom: 1.8rem;
            color: #d1d5db;
            max-width: 100%;
        }

        .cta-button {
            padding: 0.85rem 1.8rem;
            font-size: 4vw;
        }

        .happy-clients {
            margin-top: 1.8rem;
            gap: 0.75rem;
        }
    }
</style>