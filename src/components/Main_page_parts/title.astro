---
import { Image } from 'astro:assets';
import main_photo from '../../assets/images/Kamil_title_photo.jpg';
import profile from '../../assets/images/Kamil_cut.png';
import sprzet from '../../assets/images/kosiara.jpg';
---

<main class="hero-section">
    <!-- 1. Zdjęcie w tle -->
    <Image src={main_photo} class="hero-bg" alt="Tło ogrodu" />
    
    <!-- 2. Ciemna nakładka -->
    <div class="hero-overlay"></div>

    <!-- 3. Główna zawartość -->
    <div class="hero-content">
        
        <!-- Lewa strona: Tekst i przycisk -->
        <div class="hero-text-box">
            <h1>Kompleksowa pielęgnacja i zakładanie ogrodów od A do <span class="highlight">Z.</span></h1>
            <p>Dbamy o wspaniałe przestrzenie, które wnoszą piękno, wartość i harmonię do Twojego otoczenia każdego dnia.</p>
            
            <a href="#kontakt" class="cta-button">
                Rozpocznij <span class="arrow">→</span>
            </a>

            <!-- Sekcja zadowolonych klientów pod przyciskiem -->
            <div class="happy-clients">
                <div class="avatars">
                    <div class="avatar bg-gray"></div>
                    <div class="avatar bg-light"></div>
                    <div class="avatar bg-gray"></div>
                    <div class="avatar bg-light"></div>
                </div>
                <div class="clients-text">
                    <strong>120+</strong>
                    <span>Zadowolonych klientów</span>
                </div>
            </div>
        </div>

        <!-- Prawa strona: Miejsce na zdjęcie profilowe i elementy pływające -->
        <div class="hero-profile-box">
            
            <Image 
                src={profile} 
                class="profile" 
                alt="Kamil"
                format="png" 
            />

            <!-- Pływająca odznaka "Gwarancja Satysfakcji" -->
            <div class="badge-guarantee">
                <span class="icon">🌱</span>
                <span>Gwarancja<br>Satysfakcji</span>
            </div>

            <!-- Pływająca miniatura (kafelek ze sprzętem) -->
            <div class="badge-floating-card">
                <Image 
                    src={sprzet}
                    class="sprzet"
                    alt="Sprzęt"
                />
            </div>

        </div>
    </div>
</main>

<style>
/* Reset i ogólne ustawienia */
    *, *::before, *::after {
        box-sizing: border-box;
    }

    /* 1. SEKCJA GŁÓWNA (DESKTOP) */
    .hero-section {
        position: relative;
        width: 100%;
        min-height: 100vh;
        /* Zmiana: flex start żeby zawartość była przyklejona od góry, 
           a profil sam ułożył się na dole */
        display: flex;
        align-items: stretch; 
        justify-content: center;
        overflow: hidden;
        background-color: #0c3b2e;
        font-family: 'Inter', sans-serif;
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(12, 30, 20, 0.85) 35%, rgba(12, 30, 20, 0.4) 75%, rgba(0, 0, 0, 0.1) 100%);
        z-index: 2;
        pointer-events: none;
    }

    /* 2. KONTENER Z ZAWARTOŚCIĄ (DESKTOP) */
    .hero-content {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 1580px;
        min-height: 100vh; /* Zmienione z height: 100vh na min-height */
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center; /* Tekst na środku ekranu w pionie */
    }

    /* 3. LEWA STRONA - TEKST (DESKTOP) */
    .hero-text-box {
        position: relative;
        z-index: 11;
        width: 100%;
        max-width: 780px;
        color: #ffffff;
    }

    .hero-text-box h1 {
        font-size: 4rem;
        line-height: 1.15;
        font-weight: 800;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
    }

    .highlight {
        color: #c4f07a;
    }

    .hero-text-box p {
        font-size: 2rem;
        line-height: 1.6;
        color: #e5e5e5;
        margin-bottom: 2.5rem;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 1rem;
        background-color: #c4f07a;
        color: #0c3b2e;
        text-decoration: none;
        font-weight: 700;
        font-size: 1rem;
        padding: 1rem 2rem;
        border-radius: 50px;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .cta-button:hover {
        transform: translateY(-2px);
        background-color: #d1f593;
    }

    .arrow {
        font-size: 1.2rem;
        transition: transform 0.2s ease;
    }

    .cta-button:hover .arrow {
        transform: translateX(4px);
    }

    .happy-clients {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 3rem;
    }

    .avatars {
        display: flex;
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid #0c3b2e;
        margin-left: -12px;
    }

    .avatar:first-child { margin-left: 0; }
    .bg-gray { background-color: #9ca3af; }
    .bg-light { background-color: #d1d5db; }

    .clients-text {
        display: flex;
        flex-direction: column;
        font-size: 0.85rem;
    }

    .clients-text strong {
        font-size: 1.1rem;
        font-weight: 800;
    }

    .clients-text span {
        color: #d1d5db;
    }

    /* 4. PRAWA STRONA - PROFIL (DESKTOP) */
    .hero-profile-box {
        position: absolute;
        right: 2rem;
        bottom: 0; /* ZAWSZE przyklejone do dolnej krawędzi hero-section */
        width: 320px;
        height: 100vh; /* Rozmiar dopasowany do ekranu, bez przeskakiwania */
        max-height: 1000px;
        display: flex;
        justify-content: center;
        align-items: flex-end; /* Elementy wewnątrz lądują na dole */
        pointer-events: none;
        z-index: 10;
    }

    .profile {
        position: relative; /* Zmienione na relative */
        bottom: 0px; /* Minimalne schowanie ucięcia z dołu */
        width: auto;
        height: 100%; /* Dopasowuje się do rodzica hero-profile-box */
        object-fit: contain;
        object-position: bottom center;
        display: block;
        z-index: 4;
    }

    .badge-guarantee {
        position: absolute;
        bottom:290px;
        right: 440px; /* Przesunięto nieco bliżej środka, by nie wystawało za prawy brzeg ekranu na mniejszych laptopach */
        background-color: #0c3b2e;
        color: #c4f07a;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        border: 4px solid #c4f07a;
        font-size: 0.75rem;
        font-weight: 700;
        line-height: 1.2;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        z-index: 5;
    }

    .badge-guarantee .icon {
        font-size: 1.5rem;
        margin-bottom: 0.2rem;
    }

    .badge-floating-card {
        position: absolute;
        bottom: 150px; /* Lekko podniesione nad krawędź */
        right: 300px; /* Zbliżone do środka, podobnie jak badge wyżej */
        width: 200px; /* Delikatnie pomniejszone, żeby lepiej komponowało się z sylwetką */
        height:200px;
        background-color: #ffffff;
        border-radius: 16px;
        border: 4px solid #e5e5e5;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 0.85rem;
        font-weight: bold;
        color: #6b7280;
        box-shadow: 0 15px 30px rgba(0,0,0,0.4);
        z-index: 4;
        box-sizing: content-box;
        overflow: hidden; /* Zapewnia, że border-radius dotyczy też obrazka wewnątrz */
    }

    .sprzet {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

/* =======================================================
       TYLKO WIDOK MOBILNY (Telefony i małe ekrany)
       ======================================================= */
    @media (max-width: 1024px) {
        
        .hero-section {
            /* Powrót do svh - stabilna wysokość */
            height: 200vw;
            min-height: 100vh;
        }

        /* 1. NAKŁADKA (WARSTWA 3 - pomiędzy Kamilem a tekstem) */
        .hero-overlay {
            z-index: 3;
            pointer-events: none;
            background: linear-gradient(
                to bottom,
                rgba(12, 30, 20, 0) 0%,
                rgba(12, 30, 20, 0) 0%,    /* Przezroczyste na twarzy i górze */
                rgba(12, 30, 20, 0.95) 50%, /* Zaczyna mocno ciemnieć na wysokości klatki (pod tekstem) */
                rgba(12, 30, 20, 1) 60%,    /* Pełne ciemne tło */
                rgba(12, 30, 20, 1) 100%
            );
        }

        /* 2. GŁÓWNY KONTENER */
        .hero-content {
            height: auto;
            min-height: 100svw;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 6rem 1.5rem 3.5rem 1.5rem;
            z-index: auto; 
        }

        /* 3. KONTENER PROFILU */
        .hero-profile-box {
            position: absolute;
            top: 20px; /* Sztywny, bezpieczny odstęp od górnego menu. Głowa nie wjedzie wyżej. */
            left: 0;
            right: 0;
            bottom: auto; /* Kasujemy pozycjonowanie od dołu */
            width: 100%;
            height: 120svw; /* Kontener zajmuje stałą część ekranu */
            display: flex;
            justify-content: center;
            align-items: flex-end;
            z-index: auto; 
        }

        /* SAMO ZDJĘCIE KAMILA */
        .profile {
            position: relative;
            bottom: 0; /* Przestajemy podnosić zdjęcie pikselami */
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: bottom center;
            display: block;
            z-index: 2; 
        }

        /* 4. ODZNAKA SATYSFAKCJI */
        .badge-guarantee {
            position: absolute;
            top: 1svw;
            bottom: auto; /* Trzyma się dolnej krawędzi kontenera profilu, a nie całego ekranu */
            left: auto;
            right: 20px;
            width: 110px;
            height: 110px;
            font-size: 0.7rem;
            border-width: 3px;
            z-index: 5;
        }

        .badge-guarantee .icon {
            font-size: 1.5rem;
        }

        /* 5. UKRYCIE KAFELKA ZE SPRZĘTEM NA MOBILE */
        .badge-floating-card {
            display: none;
        }

        /* 6. TEKST I PRZYCISK (WARSTWA 10 - najwyżej, wyraźnie czytelny na gradiencie) */
        .hero-text-box {
            position: relative;
            z-index: 10;
            max-width: 100%;
            text-align: left;
            padding-top: 0;
            margin-top: 0;
        }

        .hero-text-box h1 {
            font-size: 7svw;
            line-height: 1.2;
            margin-bottom: 0.8rem;
        }

        .hero-text-box p {
            font-size: 1.1rem;
            line-height: 1.5;
            margin-bottom: 1.8rem;
            color: #d1d5db;
        }

        .cta-button {
            padding: 0.85rem 1.8rem;
            font-size: 1rem;
        }

        .happy-clients {
            margin-top: 1.8rem;
            gap: 0.75rem;
        }
    }
</style>