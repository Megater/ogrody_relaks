---
// src/components/Main_page_parts/uslugi.astro
import { sanityClient } from 'sanity:client';
import imageUrlBuilder from '@sanity/image-url';
import { getImage } from 'astro:assets';

// Importy lokalnych zdjęć zapasowych (fallback)
import trawnikImg from '../../assets/images/Realizacje/trawnik.jpg';
import porzadkowanieImg from '../../assets/images/Realizacje/porzadkowanie_dzialki.jpg';
import dzialkaPrzedPoImg from '../../assets/images/Realizacje/dzialka_przed_po.jpg';
import kosiaraImg from '../../assets/images/kosiara.jpg';
import anthonyImg from '../../assets/images/anthony-Apips1tJsXo-unsplash.jpg';
import claudeImg from '../../assets/images/claude-laprise-lW2TOQZ_bys-unsplash.jpg';

interface ServiceItem {
  title: string;
  slug: string;
  badge: string;
  icon: string;
  shortDescription: string;
  description: string;
  features: string[];
  images: string[];
}

// Konfiguracja buildera zdjęć Sanity
const builder = imageUrlBuilder(sanityClient);
function urlFor(source: any) {
  return builder.image(source);
}

// 1. Pobieranie danych z Sanity
let sanityUslugi: any[] = [];
try {
  sanityUslugi = await sanityClient.fetch(`
    *[_type == "usluga"] | order(order asc, _createdAt desc) {
      title,
      "slug": slug.current,
      badge,
      icon,
      shortDescription,
      description,
      features,
      image,
      gallery,
      order
    }
  `);
} catch (error) {
  console.warn("Błąd pobierania usług z Sanity – używam danych zastępczych.");
}

// Pomocnik do wyciągania linku URL ze zdjęcia (Sanity lub lokalny import)
function getImgSrc(img: any): string {
  if (!img) return '';
  if (typeof img === 'string') return img;
  if (img.src) return img.src;
  if (img.asset) {
    try {
      return urlFor(img).width(900).quality(85).auto('format').url();
    } catch {
      return '';
    }
  }
  return '';
}

// 2. Dane zastępcze (działają dopóki nie wprowadzisz danych w Sanity /studio)
const trawnikOpt = await getImage({ src: trawnikImg, width: 500, format: 'webp', quality: 70 });
const porzadkowanieOpt = await getImage({ src: porzadkowanieImg, width: 500, format: 'webp', quality: 70 });
const dzialkaPrzedPoOpt = await getImage({ src: dzialkaPrzedPoImg, width: 500, format: 'webp', quality: 70 });
const kosiaraOpt = await getImage({ src: kosiaraImg, width: 500, format: 'webp', quality: 70 });
const anthonyOpt = await getImage({ src: anthonyImg, width: 500, format: 'webp', quality: 70 });
const claudeOpt = await getImage({ src: claudeImg, width: 500, format: 'webp', quality: 70 });

const trawnikSrc = trawnikOpt.src;
const porzadkowanieSrc = porzadkowanieOpt.src;
const dzialkaPrzedPoSrc = dzialkaPrzedPoOpt.src;
const kosiaraSrc = kosiaraOpt.src;
const anthonySrc = anthonyOpt.src;
const claudeSrc = claudeOpt.src;

const fallbackUslugi: ServiceItem[] = [
  {
    title: "Pielęgnacja i regeneracja trawników",
    slug: "pielegnacja-trawnikow",
    badge: "Wiosna / Cały sezon",
    icon: "🌱",
    shortDescription: "Kompleksowa regeneracja darni: wertykulacja, aeracja, dosiewki oraz profesjonalne nawożenie mineralne.",
    description: "Przywracamy trawnikom soczystą zieleń, gęstość i sprężystość. Skutecznie usuwamy filc, chwasty i mech blokujące dopływ tlenu i wody. Napowietrzamy strefę korzeniową i stosujemy bezpieczne nawozy długodziałające dopasowane do fazy wzrostu. Twój trawnik zyskuje odporność na suszę i intensywne użytkowanie.",
    features: [
      "Wertykulacja mechaniczna – oczyszczenie z filcu i mchu",
      "Aeracja rurkowa wgłębna – napowietrzenie strefy korzeni",
      "Dosiewka regeneracyjna nasionami o podwyższonej odporności",
      "Dobór i rozsiew nawozów startowych oraz całorocznych"
    ],
    images: [trawnikSrc, kosiaraSrc, anthonySrc]
  },
  {
    title: "Porządkowanie i karczowanie zarośniętych działek",
    slug: "porzadkowanie-dzialek",
    badge: "Przygotowanie terenu",
    icon: "🚜",
    shortDescription: "Usuwanie dzikich samosiewów, chaszczy, zarośli i przygotowanie terenu pod budowę, ogród lub inwestycję.",
    description: "Specjalizujemy się w doprowadzaniu do ładu nawet najbardziej zapuszczonych, gęsto zarośniętych posesji. Wycinamy chaszcze, wycinamy samosiewy i krzaki, karczujemy pnie oraz rozdrabniamy gałęzie mobilnym rębakiem. Zapewniamy wywóz bioodpadów i wyrównanie terenu, podnosząc wartość każdej parceli.",
    features: [
      "Wykaszanie wysokich chaszczy i zarośli kosiarkami karczowniczymi",
      "Wycinka dzikich drzew, samosiewów i inwazyjnych krzewów",
      "Rozdrabnianie gałęzi na zrębkę lub pełna utylizacja z wywozem",
      "Wstępne niwelowanie i wyrównanie gruntu pod inwestycję"
    ],
    images: [porzadkowanieSrc, dzialkaPrzedPoSrc, kosiaraSrc]
  },
  {
    title: "Przygotowanie działek pod sprzedaż (Home Staging)",
    slug: "przygotowanie-pod-sprzedaz",
    badge: "Szybka metamorfoza",
    icon: "🏡",
    shortDescription: "Ekspresowe podniesienie walorów wizualnych nieruchomości przed przyjazdem potencjalnych kupców.",
    description: "Pierwsze wrażenie robi się tylko raz. Zadbana, równa działka z estetycznie przyciętą zielenią przyciąga zdecydowanie więcej chętnych i pozwala uzyskać wyższą cenę transakcyjną. W ciągu zaledwie 1-2 dni przekształcamy zarośnięty teren w uporządkowaną, reprezentacyjną przestrzeń gotową do prezentacji.",
    features: [
      "Precyzyjne wykoszenie całej posesji i czyszczenie krawędzi",
      "Prześwietlenie koron drzew i formowanie przerośniętych żywopłotów",
      "Uprzątnięcie zalegających gałęzi, suchych liści i odpadów",
      "Widoczne odsłonięcie granic działki i walorów krajobrazowych"
    ],
    images: [dzialkaPrzedPoSrc, porzadkowanieSrc, trawnikSrc]
  },
  {
    title: "Formowanie żywopłotów, cięcie drzew i krzewów",
    slug: "ciecie-drzew-i-krzewow",
    badge: "Pielęgnacja roślin",
    icon: "✂️",
    shortDescription: "Precyzyjne cięcia sanitarne, korygujące, odmładzające oraz geometryczne modelowanie tui i krzewów.",
    description: "Prawidłowe cięcie to klucz do bujnego zagęszczenia, zdrowia i pięknego kwitnienia roślin. Dbamy o właściwe terminy zabiegów ogrodniczych, dezynfekujemy narzędzia i zabezpieczamy rany drzew specjalistycznymi maściami. Nadajemy żywopłotom idealnie równe, geometryczne linie.",
    features: [
      "Równanie i skracanie żywopłotów z tui, grabów, buków i ligustru",
      "Cięcia sanitarne: usuwanie chorych, suchych i połamanych gałęzi",
      "Cięcia odmładzające i prześwietlające stare krzewy owocowe i ozdobne",
      "Sprzątanie, mielenie urobku rębakiem i porządek po zabiegach"
    ],
    images: [claudeSrc, trawnikSrc, anthonySrc]
  }
];

// Ostateczna lista usług (Sanity lub fallback)
const servicesList: ServiceItem[] = (sanityUslugi && sanityUslugi.length > 0)
  ? sanityUslugi.map((item: any) => {
      const allImgs: string[] = [];
      const mainImgSrc = getImgSrc(item.image);
      if (mainImgSrc) allImgs.push(mainImgSrc);

      if (item.gallery && Array.isArray(item.gallery)) {
        item.gallery.forEach((gImg: any) => {
          const gSrc = getImgSrc(gImg);
          if (gSrc && !allImgs.includes(gSrc)) {
            allImgs.push(gSrc);
          }
        });
      }

      // Upewniamy się, że mamy przynajmniej 1-3 zdjęcia
      if (allImgs.length === 0) allImgs.push(trawnikSrc);
      while (allImgs.length < 3) {
        if (!allImgs.includes(trawnikSrc)) allImgs.push(trawnikSrc);
        else if (!allImgs.includes(porzadkowanieSrc)) allImgs.push(porzadkowanieSrc);
        else allImgs.push(kosiaraSrc);
      }

      return {
        title: item.title || 'Usługa ogrodnicza',
        slug: item.slug || 'usluga',
        badge: item.badge || 'Sezonowa usługa',
        icon: item.icon || '🌿',
        shortDescription: item.shortDescription || 'Kompleksowe usługi ogrodnicze dla Twojego ogrodu.',
        description: item.description || 'Profesjonalna realizacja prac ogrodowych z użyciem specjalistycznego sprzętu.',
        features: (item.features && item.features.length > 0) ? item.features : [
          "Bezpłatna wycena i dojazd na działkę",
          "Własny park maszynowy i doświadczona ekipa",
          "Szybka realizacja i pełny porządek po pracach"
        ],
        images: allImgs.slice(0, 3)
      };
    })
  : fallbackUslugi;
---

<section class="services-section" id="uslugi">
  <div class="container">
    
    <!-- NAGŁÓWEK SEKCJI W STYLU MAKIETY -->
    <div class="services-header">
      <div class="header-left">
        <span class="kicker">
          <span class="kicker-dot" aria-hidden="true"></span>
          NASZE USŁUGI
        </span>
        <h2 class="title">
          Wszystko, czego potrzebuje Twój <span class="italic-highlight">ogród</span>
        </h2>
      </div>

      <div class="header-right">
        <p class="subtitle">
          Zapewniamy pełny cykl sezonowej opieki i prac terenowych – jeden sprawdzony wykonawca, bez stresu i pośredników.
        </p>
        <a href="/uslugi" class="view-all-link">
          <span>Przejdź do pełnej oferty</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- STATYCZNE, ROZSUWANE MENU USŁUG (AKORDEON) -->
    <div class="services-accordion" id="services-accordion">
      {servicesList.map((service, index) => {
        const isOpen = index === 0; // Pierwsza usługa jest domyślnie rozwinięta
        return (
          <div 
            class={`service-card ${isOpen ? 'is-open' : ''}`}
            data-service-index={index}
          >
            <!-- PASEK GŁÓWNY (NAGŁÓWEK KAFELKA - ZAWSZE WIDOCZNY) -->
            <button 
              type="button" 
              class="service-trigger" 
              aria-expanded={isOpen ? 'true' : 'false'}
              aria-controls={`service-content-${index}`}
            >
              <div class="trigger-left">
                <div class="service-icon-box" aria-hidden="true">
                  <span>{service.icon}</span>
                </div>
                <div class="service-info-preview">
                  <div class="meta-row">
                    <span class="service-badge">{service.badge}</span>
                    <span class="service-counter">0{index + 1}</span>
                  </div>
                  <span class="service-name">{service.title}</span>
                  <p class="service-short-desc">{service.shortDescription}</p>
                </div>
              </div>

              <div class="trigger-right">
                <span class="toggle-label">{isOpen ? 'Zwiń opis' : 'Rozwiń opis'}</span>
                <div class="toggle-circle" aria-hidden="true">
                  <svg class="chevron-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </div>
              </div>
            </button>

            <!-- ROZSUWANA ZAWARTOŚĆ (PŁYNNIE ROZSUWANA PO KLIKNIĘCIU) -->
            <div 
              class="service-collapse" 
              id={`service-content-${index}`}
              aria-hidden={isOpen ? 'false' : 'true'}
            >
              <div class="collapse-inner">
                <div class="service-details-grid">
                  
                  <!-- LEWA KOLUMNA: CZYTELNY OPIS I PUNKTY OFERTY -->
                  <div class="details-text-col">
                    <div class="expanded-title-wrapper">
                      <span class="expanded-badge">{service.badge}</span>
                      <h3 class="expanded-title">{service.title}</h3>
                    </div>

                    <p class="expanded-text">{service.description}</p>

                    <div class="features-box">
                      <h4 class="features-title">Co obejmuje zakres prac:</h4>
                      <ul class="features-list">
                        {service.features.map((feature) => (
                          <li>
                            <span class="check-icon" aria-hidden="true">
                              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                              </svg>
                            </span>
                            <span>{feature}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- AKCJE DLA DANEJ USŁUGI -->
                    <div class="service-actions">
                      <a href="/#rezerwacja" class="btn-primary">
                        <span>Zarezerwuj tę usługę (0 zł)</span>
                        <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                      </a>
                      <a href={`/uslugi#szczegoly-${service.slug}`} class="btn-secondary">
                        <span>Więcej szczegółów</span>
                        <span class="btn-arrow" aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </div>

                  <!-- PRAWA KOLUMNA: 3 ZDJĘCIA W ESTETYCZNEJ SIATCE -->
                  <div class="details-gallery-col">
                    <div class="gallery-header">
                      <span class="gallery-tag">Galeria realizacji</span>
                      <span class="gallery-count">3 zdjęcia</span>
                    </div>

                    <div class="service-photos-mosaic">
                      {service.images.map((imgSrc, imgIdx) => (
                        <a 
                          href={`/uslugi#szczegoly-${service.slug}`} 
                          class={`mosaic-item item-${imgIdx + 1}`}
                          title={`Zobacz usługę: ${service.title} w pełnej ofercie`}
                          aria-label={`Przejdź do oferty: ${service.title}`}
                        >
                          <img 
                            src={imgSrc} 
                            alt={`${service.title} - zdjęcie ${imgIdx + 1}`}
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="photo-overlay" aria-hidden="true">
                            <span class="overlay-text">
                              <span>Zobacz ofertę</span>
                              <span class="arrow">&rarr;</span>
                            </span>
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>

                </div>
              </div>
            </div>

          </div>
        );
      })}
    </div>

    <!-- DOLNY PASEK ZAPRASZAJĄCY DO PEŁNEJ PODSTRONY -->
    <div class="services-footer-banner">
      <div class="banner-content">
        <span class="banner-icon" aria-hidden="true">🌿</span>
        <div class="banner-text">
          <strong>Szukasz indywidualnego pakietu lub wyceny na działce?</strong>
          <span>Zobacz pełną podstronę z opisami wszystkich opcji i cennikiem lub skontaktuj się z nami bezpośrednio.</span>
        </div>
      </div>
      <div class="banner-actions">
        <a href="/uslugi" class="btn-banner-link">Przejdź do strony Usługi &rarr;</a>
        <a href="tel:+48535262302" class="btn-banner-phone">+48 535 262 302</a>
      </div>
    </div>

  </div>
</section>

<!-- Skrypt obsługujący płynne rozsuwanie kafelków (akordeon) -->
<script>
  function setupServicesAccordion() {
    const accordion = document.getElementById('services-accordion');
    if (!accordion) return;

    const cards = accordion.querySelectorAll('.service-card');

    cards.forEach((card) => {
      const trigger = card.querySelector('.service-trigger') as HTMLButtonElement | null;
      const collapse = card.querySelector('.service-collapse') as HTMLElement | null;
      const label = card.querySelector('.toggle-label');

      if (!trigger || !collapse) return;

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = card.classList.contains('is-open');

        // Opcja: zwinięcie pozostałych lub niezależne rozwijanie
        // Aby użytkownik miał wygodny przegląd, możemy zwinąć pozostałe:
        cards.forEach((otherCard) => {
          if (otherCard !== card && otherCard.classList.contains('is-open')) {
            otherCard.classList.remove('is-open');
            const otherTrigger = otherCard.querySelector('.service-trigger');
            const otherCollapse = otherCard.querySelector('.service-collapse');
            const otherLabel = otherCard.querySelector('.toggle-label');
            if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
            if (otherCollapse) otherCollapse.setAttribute('aria-hidden', 'true');
            if (otherLabel) otherLabel.textContent = 'Rozwiń opis';
          }
        });

        // Przełączenie klikniętego kafelka
        if (isOpen) {
          card.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
          collapse.setAttribute('aria-hidden', 'true');
          if (label) label.textContent = 'Rozwiń opis';
        } else {
          card.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          collapse.setAttribute('aria-hidden', 'false');
          if (label) label.textContent = 'Zwiń opis';
        }
      });
    });

    // Niezawodne przekierowanie na stronę /uslugi po kliknięciu w dowolne zdjęcie na desktopie i mobile
    const mosaicLinks = accordion.querySelectorAll('.mosaic-item');
    mosaicLinks.forEach((link) => {
      link.addEventListener('click', (e: Event) => {
        const mouseEv = e as MouseEvent;
        if (mouseEv.button !== 0 || mouseEv.ctrlKey || mouseEv.metaKey || mouseEv.shiftKey) return;
        const href = (link as HTMLAnchorElement).href;
        if (href) {
          window.location.href = href;
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupServicesAccordion);
  } else {
    setupServicesAccordion();
  }
  document.addEventListener('astro:page-load', setupServicesAccordion);
</script>

<style>
  /* ==========================================================================
     SEKCJA USŁUG - ROZSUWANE MENU ZGODNE Z KOLORYSTYKĄ STRONY
     Paleta: Ciemny zielony (#153c24), Jasny zielony (#86b942), Tło (#f4f9f6)
     ========================================================================== */
  .services-section {
    padding: 100px 0;
    background-color: #f8faf8; /* Czyste, świeże tło spójne z całą stroną */
    font-family: 'Inter', sans-serif;
    width: 100%;
    box-sizing: border-box;
    position: relative;
  }

  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* --- NAGŁÓWEK SEKCJI W STYLU MAKIETY --- */
  .services-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 50px;
    width: 100%;
    box-sizing: border-box;
  }

  .header-left {
    max-width: 640px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #86b942;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 14px;
  }

  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #86b942;
    display: inline-block;
  }

  .title {
    font-size: clamp(2.1rem, 4.5vw, 3.2rem);
    font-weight: 800;
    color: #153c24;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .italic-highlight {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 600;
    color: #86b942;
  }

  .header-right {
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    text-align: left;
  }

  .subtitle {
    font-size: 0.98rem;
    line-height: 1.6;
    color: #4b5563;
    margin: 0;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #ffffff;
    border: 1.5px solid #153c24;
    color: #153c24;
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .view-all-link:hover {
    background-color: #153c24;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(21, 60, 36, 0.18);
  }

  .view-all-link .arrow {
    font-size: 1.05rem;
    transition: transform 0.2s ease;
  }

  .view-all-link:hover .arrow {
    transform: translate(2px, -2px);
  }

  /* --- AKORDEON USŁUG (STATYCZNE ROZSUWANE MENU) --- */
  .services-accordion {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    box-sizing: border-box;
  }

  .service-card {
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 20px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
  }

  .service-card:hover {
    border-color: #86b942;
    box-shadow: 0 8px 24px rgba(21, 60, 36, 0.08);
  }

  .service-card.is-open {
    border-color: #86b942;
    box-shadow: 0 12px 36px rgba(21, 60, 36, 0.12);
  }

  /* --- TRIGGER (ZNAJDUJE SIĘ NA KAFELKU ZAWSZE) --- */
  .service-trigger {
    width: 100%;
    padding: 24px 30px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    text-align: left;
    font-family: inherit;
    transition: background-color 0.2s ease;
  }

  .service-trigger:hover {
    background-color: #fafdfb;
  }

