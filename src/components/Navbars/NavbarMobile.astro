---
import { Image } from 'astro:assets';
import logo from '../images/shorter_logo.png'
import more from '../images/more.png'
import MenuRoll from '../NavbarM_menu/menu_roll.astro';
---

<div id="main">
    <div id="logo">
        <Image src={logo} alt="Logo" height="60" />
    </div>
    <div id="katalog">
        <button id="menu-btn" class="menu-btn" aria-label="Menu">
            <Image src={more} alt="more_button" height="20" />
        </button>
    </div>
</div>
<div id="box" class="box"> <MenuRoll/> </div>

<script>
    const button = document.getElementById('menu-btn');
    const box = document.getElementById('box');

    button?.addEventListener('click', () => {
        box?.classList.toggle('is-open');
    });
</script>



<style>
    .box{
        display: none;
    }

    .box.is-open{
        display: flex;
    }



    #main{
        margin: auto auto auto auto;
        background: rgba(255, 255, 255, 0.864);
        width: 100%;
        height: 80px;
        color: #11301e;    
        display:grid;
        grid-template-columns: 1fr 1fr;
        justify-content: space-between;
        align-items: center;
        box-sizing: border-box;
        gap: 20px;
    }
    #logo{
        margin: 6px auto auto 10px;
        transition: all 0.1s ease;
    }

    #logo:active{
        scale:110%
    }

    #katalog{
        margin: 0 5px 2px auto;
        display: flex;
        justify-content: center;
    }


    #katalog button{
        background: transparent;
        border: 0;
        padding: 25px;      
        border-radius: 25px;
        text-decoration: none;
        color: #143623;           /* głęboka, elegancka butelkowa zieleń */
        transition: all 0.25s ease-in-out;
        display: flex;
        align-items: center;

    }
    #katalog button:active {
        background: rgba(166, 206, 105, 0.535); 
        scale: 115%;
    }


</style>