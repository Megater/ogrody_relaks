---
import { Image } from 'astro:assets';
import logo from '../images/shorter_logo.png'
import more from '../images/more.png'
import MenuRoll from '../NavbarM_menu/menu_roll.astro';
---

<div id="main">
    <div id="logo">
        <Image src={logo} alt="Logo" width="145"; />
    </div>
    <div id="katalog">
        <button id="menu-btn" class="menu-btn" aria-label="Menu">
            <Image src={more} alt="more_button" height="20" />
        </button>
    </div>
</div>
<div id="box" class="box"> <MenuRoll/> </div>

<script>
    const button = document.getElementById('menu-btn');
    const box = document.getElementById('box');

    button?.addEventListener('click', () => {
        box?.classList.toggle('is-open');
        button?.classList.toggle('clicked');
    });
</script>

<style>
    /* Płynnie rozsuwany kontener siatkowy */
    .box {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .box.is-open {
        grid-template-rows: 1fr;
    }

    #main {
        margin: auto;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        width: 100%;
        height: 80px;
        color: #11301e;    
        display: grid;
        grid-template-columns: 1fr 1fr;
        justify-content: space-between;
        align-items: center;
        box-sizing: border-box;
        gap: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    #logo {
        margin: 6px auto auto 14px;
        transition: transform 0.15s ease;
    }

    #logo:active {
        transform: scale(1.05);
    }

    #katalog {
        margin: 0 10px 0 auto;
        display: flex;
        justify-content: center;
    }

    .menu-btn {
        background-color: transparent;
        border: 0;
        padding: 16px;      
        border-radius: 16px;
        text-decoration: none;
        color: #143623;
        transition: background 0.2s ease, transform 0.15s ease;
        display: flex;
        align-items: center;
        cursor: pointer;
    }

    .menu-btn.clicked {
        background: rgba(166, 206, 105, 0.3); 
        transform: scale(0.95);
    }
</style>