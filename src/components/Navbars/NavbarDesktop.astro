---
import { Image } from 'astro:assets';
import logo from '../../assets/images/shorter_logo.png'
---


<div id="main">
    <div id="logo">
        <Image src={logo} alt="logo_img" height="60" />
    </div>
    <div id="Navlinks">
        <a>Strona Glowna</a>
        <span class="dot">•</span>
        <a>Realizacje</a>
        <span class="dot">•</span>
        <a>Jak dzialamy</a>
        <span class="dot">•</span>
        <a>O nas</a>
        <span class="dot">•</span>
        <a>Opinie</a>

    </div>
    <div id="Wycena">
        Wycena
    </div>
</div>

<style>
    #main {
        margin: 10px auto 0 auto;
        background: rgba(255, 255, 255, 0.864);
        width: 75%;
        height: 75px;
        border-radius: 20px;
        color: #11301e;    
        display:grid;
        grid-template-columns: 1fr auto 1fr;
        justify-content: space-between;
        align-items: center;
        min-width: 1024px;
        padding: 0 25px;
        box-sizing: border-box;
    }

    #logo{

        justify-self: start;
        margin: auto auto auto 0;
        transition: all 0.1s ease-in;
    }
    #logo:active{
        scale: 105%
    }

    #Navlinks {
        justify-self: center;
        justify-content: flex-start;
        display: flex;
        gap: 20px;
        align-items: center;      
        list-style: none;        
        margin: 0;
        padding: 0;
        margin-bottom: 3px;
    }

    /* Wygląd samych linków w środku */
    #Navlinks a {
        padding: 15px;      
        border-radius: 10px;
        text-decoration: none;
        color: #143623;           /* głęboka, elegancka butelkowa zieleń */
        font-size: 16px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease-in-out;
        display: flex;
        align-items: center;
        gap: 20px;                /* równy odstęp do kropki rozdzielającej */
    }

    /* Kolor po najechaniu myszką */
    #Navlinks a:hover {
        background: rgba(166, 206, 105, 0.535); 
        font-weight: 700;
        scale: 115%;
    }

    #Wycena {
        justify-self: end;
        background: #84cc16;           /* soczysty, naturalny limonkowy odcień */
        color: #11301e;                /* ciemna, elegancka butelkowa zieleń */
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        padding: 12px;
        border-radius: 50px;           /* zaokrąglona pigułka wygląda nowocześnie */
        display: inline-block;
        transition: all 0.3s ease-in-out;
        box-shadow: 0 4px 12px rgba(132, 204, 22, 0.35); /* subtelny zielony blask */

    }

    #Wycena:hover {
        background: #65a30d;           /* lekko ciemniejszy po najechaniu */
        transform: translateY(-2px);   /* delikatne uniesienie */
        box-shadow: 0 6px 16px rgba(132, 204, 22, 0.45);
    }
    .dot{
        color: #84cc16;
        user-select: none;
    }

</style>