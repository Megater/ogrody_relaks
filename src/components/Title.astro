---
import { Image } from "astro:assets";
import garden from "../assets/Images/garden2.jpg"
---
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Lugrasimo&family=Yesteryear&display=swap" rel="stylesheet">
</head>
<main>


    <div class="text">
        <li class="info">Grójec i okolice</li>
        <h1>Stwórzmy przestrzeń, w której odetchniesz. 🏖️</h1>
    </div>

    <div class="bg_cover"></div>
    <div class="bg_img">
        <Image 
        src={garden} 
        alt="garden_photo" 
        class="garden_img"
        />
    </div>



</main>

<style>
    main{
        display: flex;
        width: 100%;
        margin: auto;
    }
    .bg_img{
        display: block;
        width: auto;
        height: 88svh;
        margin: auto;
        margin-right: 0;
        z-index: 1;
    }


    .garden_img{
        position: relative;
        z-index: 1;
        height: 100%;
        width: 1300px;
    }

    .bg_cover{
        position:absolute;
        width: 100%;
        height: 88svh;
        z-index: 2;
        background: linear-gradient(to right, rgb(231, 231, 231) 45%, rgba(231, 231, 231, 0.2), rgba(231, 231, 231, 0));
    }

    .text{
        position:absolute;
        color: rgb(20, 90, 53);
        z-index: 3;
        width: 40%;
        margin: 30px;
        text-align: left;
        justify-content: center;

    }

    .text h1{
        font-family: "Lugrasimo", cursive;
        font-weight: 400;
        font-style: normal;
        font-size:60px;
        text-shadow: 10px 1px 30px rgba(0, 0, 0, 0.6);
        margin: auto;
    }

    .text li{
        font-size: 25px;
        margin: auto;

        margin-bottom: 80px;
    }
</style>