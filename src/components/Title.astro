---
import { Image } from "astro:assets";
import garden from "../assets/Images/garden2.jpg"
---

<main>

    <div class="bg_img">
    <div class="bg_cover">Siema</div>
    <Image 
    src={garden} 
    alt="garden_photo" 
    class="garden_img"
    />
    </div>
</main>

<style>
    main{
        display: flex;
        width: 100%;
        margin: auto;
    }
    .bg_img{
        display: flex;
        width: auto;
        height: 88svh;
        margin: auto;
        margin-right: 10;
        z-index: 10;
    }


    .garden_img{
        height: 100%;
        width: 1300px;
    }

    .bg_cover{
        position:fixed;
        width: 100%;
        height: 100%;
        background: rgb(0, 0, 0 ,0.5);
        color:white;
        z-index: 9;
    }
</style>